#!/usr/bin/env bash
# CONFORMANCE blazer x enc.sse_c -- the contract is bin/conformance/README.md.
#
# Scenario: SSE-C simple and multipart round-trips, ranged read and copy.
#
# B2 requires the same three Customer-* values on upload and every subsequent
# download, including HEAD and ranged requests. b2_start_large_file and
# b2_copy_file instead carry SSE-C settings in JSON; every b2_upload_part still
# carries the Customer-* headers. A wrong key returns 403.
# https://www.backblaze.com/docs/cloud-storage-use-sse-with-customer-managed-keys-ssec
# https://www.backblaze.com/apidocs/b2-upload-file
# https://www.backblaze.com/apidocs/b2-start-large-file
# https://www.backblaze.com/apidocs/b2-upload-part
# https://www.backblaze.com/apidocs/b2-download-file-by-name
# https://www.backblaze.com/apidocs/b2-copy-file
# https://github.com/Backblaze/blazer/releases/tag/v0.10.0
#
# Exercises the checked-out github.com/Backblaze/blazer module through a local Go `replace`; the orchestrator selects the exact clean revision. The scenario semantics came from the fleet card and B2 API documentation.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd -P)"

SLUG=blazer
CAP=enc.sse_c
TARGET=simulator

say() { printf 'CONFORMANCE %s %s @%s: %s\n' "$SLUG" "$CAP" "$1" "$2"; }

# A detail never carries a response body, a multi-line diagnostic or a
# credential: one line, printable, capped.
tidy_detail() { printf '%s' "$1" | tr '\n\r\t' '   ' | tr -cd '[:print:]' | cut -c1-200; }

. "$(dirname "$0")/../lib/contract.sh"
if ! sdkharness_leaf_guard CONFORMANCE_TARGET CONFORMANCE_SIMULATOR_URL; then
  say simulator "FAIL ($SDKHARNESS_GUARD_REASON)"
  exit 1
fi
sdkharness_go_offline_env

if ! command -v go >/dev/null 2>&1; then
  say "$TARGET" "COULD-NOT-RUN (missing-runtime -- no Go toolchain on PATH)"
  exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-conf-blazer.XXXXXX")" || {
  say "$TARGET" "FAIL (setup -- could not create a scratch directory)"
  exit 1
}
trap 'rm -rf "$work"' EXIT HUP INT TERM

# The Go program is carried at the end of this file as an INERT heredoc, so
# `bash -n` parses this check as the shell script it is rather than choking on
# Go syntax.
awk '/^__EOF_GO__$/ { inprog = 0 } inprog { print } /^: <</ { inprog = 1 }' "$0" > "$work/main.go"
cat > "$work/go.mod" <<EOF
module sdkharness-conformance-blazer

go 1.18

require github.com/Backblaze/blazer v0.8.0

replace github.com/Backblaze/blazer => $REPO_ROOT
EOF


# Build and run are deliberately separate, and only a missing or unusable Go
# toolchain is an ABSENT RUNTIME (amber). A module that does not compile, a
# failing `go mod tidy` and a missing dependency are all a defect in blazer or
# in this check (red): hiding them as amber would turn a regression into
# harmless evidence. sdkharness_go_build (lib/contract.sh) draws that line.
cp "$(dirname "$0")/../lib/loopback_guard.go.txt" "$work/loopback_guard.go"
sdkharness_go_build "$work" check
case "$?" in
  0) ;;
  10) say "$TARGET" "COULD-NOT-RUN (missing-runtime -- $SDKHARNESS_BUILD_REASON)"; exit 0 ;;
  *) say "$TARGET" "FAIL (build -- blazer or this check did not compile offline: $(tidy_detail "$SDKHARNESS_BUILD_OUT"))"; exit 1 ;;
esac

run_out="$("$work/check" 2>&1)"
run_rc=$?

printf '%s\n' "$run_out" | grep -E '^NOTE ' || true
line="$(printf '%s\n' "$run_out" | grep -E "^CONFORMANCE $SLUG $CAP @" | tail -1)"
if [ -z "$line" ]; then
  say "$TARGET" "FAIL (harness -- the check binary produced no result line: $(tidy_detail "$run_out"))"
  exit 1
fi
printf '%s\n' "$line"
exit "$run_rc"

: <<'__EOF_GO__'
package main

// blazer x enc.sse_c.
//
// Setup   a bucket
// Action  upload with a caller-provided AES-256 key
// Assert  no/wrong key fails; correct key round-trips simple and multipart
//         bytes; keyed HEAD, parallel ranged read and keyed copy succeed

import (
	"bytes"
	"context"
	"crypto/md5"
	"crypto/rand"
	"crypto/sha1"
	"encoding/base64"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"io"
	"net/http"
	"os"
	"reflect"
	"regexp"
	"sort"
	"strings"
	"sync"

	"github.com/Backblaze/blazer/b2"
)

const capability = "enc.sse_c"

func runCheck(ctx context.Context, target *string) error {
	const keyID = "sdkharness-sse-c-key-1"
	rawKey := make([]byte, 32)
	wrongRawKey := make([]byte, 32)
	if _, err := rand.Read(rawKey); err != nil {
		return failf("key setup", "could not generate a test key")
	}
	if _, err := rand.Read(wrongRawKey); err != nil {
		return failf("key setup", "could not generate a second test key")
	}
	key, err := b2.NewSSECKeyWithID(rawKey, keyID)
	if err != nil {
		return failf("key setup", "a 32-byte key was rejected")
	}
	wrongKey, err := b2.NewSSECKey(wrongRawKey)
	if err != nil {
		return failf("key setup", "a second 32-byte key was rejected")
	}
	secretsToScrub = append(secretsToScrub, string(rawKey), string(wrongRawKey))
	keyValue := base64.StdEncoding.EncodeToString(rawKey)
	keyDigest := md5.Sum(rawKey)
	keyMD5 := base64.StdEncoding.EncodeToString(keyDigest[:])
	secretsToScrub = append(secretsToScrub, keyValue)

	baseURL, err := apiBase(*target)
	if err != nil {
		return err
	}
	id, secret, err := credentials(*target)
	if err != nil {
		return err
	}
	audit := &wireAudit{key: keyValue}
	client, err := b2.NewClient(ctx, id, secret, b2.APIBase(baseURL), b2.Transport(audit), b2.UserAgent("sdkharness-conformance/blazer"))
	if err != nil {
		return classify("authenticate", err)
	}

	bucket, cleanup, err := newBucket(ctx, client, &b2.BucketAttrs{Type: b2.Private})
	if err != nil {
		return err
	}
	defer cleanup()

	payload := payloadOf(4096)
	name := objectName("sse-c-simple.bin")
	object := bucket.Object(name)
	writer := object.NewWriter(ctx, b2.WithSSECKey(key))
	if _, err := writer.Write(payload); err != nil {
		writer.Close()
		return classify("simple upload", err)
	}
	if err := writer.Close(); err != nil {
		return classify("simple upload", err)
	}

	if _, err := readAll(ctx, object.NewReader(ctx)); err == nil {
		return failf("missing key", "an SSE-C object downloaded without a key")
	}
	if _, err := readAll(ctx, object.NewReader(ctx, wrongKey)); err == nil {
		return failf("wrong key", "an SSE-C object downloaded with the wrong key")
	}
	beforeGoodRead := audit.count()
	got, err := readAll(ctx, object.NewReader(ctx, key))
	if err != nil {
		return classify("simple download", err)
	}
	if !bytes.Equal(got, payload) {
		return failf("simple round trip", "the keyed download bytes differ from the upload")
	}
	if err := assertKeyedRead(audit.since(beforeGoodRead), http.MethodGet, keyValue, keyMD5); err != nil {
		return err
	}

	beforeAttrs := rpcCounts(client)
	beforeHead := audit.count()
	// A fresh handle has no cached version, so Attrs resolves the SSE-C object by name with a keyed HEAD.
	attrs, err := bucket.Object(name).Attrs(ctx, key)
	if err != nil {
		return classify("keyed HEAD", err)
	}
	if attrs.Size != int64(len(payload)) {
		return failf("keyed HEAD", "size %d, expected %d", attrs.Size, len(payload))
	}
	if got := attrs.Info["sse_c_key_id"]; got != keyID {
		return failf("keyed HEAD", "sse_c_key_id = %q, want caller key ID", got)
	}
	if err := assertSDKEncryption("keyed HEAD", attrs); err != nil {
		return err
	}
	if !anyContains(rpcDelta(beforeAttrs, rpcCounts(client)), "download_file_by_name") {
		return failf("keyed HEAD", "Object.Attrs with an SSE-C key did not issue the required HEAD request")
	}
	if err := assertKeyedRead(audit.since(beforeHead), http.MethodHead, keyValue, keyMD5); err != nil {
		return err
	}
	// This handle already identifies the version, so Attrs reads its metadata by ID.
	beforeResolvedAttrs := rpcCounts(client)
	resolvedAttrs, err := object.Attrs(ctx, key)
	if err != nil {
		return classify("resolved attrs", err)
	}
	if resolvedAttrs.Size != int64(len(payload)) {
		return failf("resolved attrs", "size %d, expected %d", resolvedAttrs.Size, len(payload))
	}
	if err := assertSDKEncryption("resolved attrs", resolvedAttrs); err != nil {
		return err
	}
	if anyContains(rpcDelta(beforeResolvedAttrs, rpcCounts(client)), "download_file_by_name") {
		return failf("resolved attrs", "an already resolved object unexpectedly issued a keyed HEAD request")
	}

	largePayload := payloadOf(5_000_000 + 4096)
	largeName := objectName("sse-c-large.bin")
	largeObject := bucket.Object(largeName)
	largeWriter := largeObject.NewWriter(ctx, b2.WithSSECKey(key))
	largeWriter.ChunkSize = 5_000_000
	largeWriter.ConcurrentUploads = 2
	beforeLarge := audit.count()
	if _, err := largeWriter.Write(largePayload); err != nil {
		largeWriter.Close()
		return classify("multipart upload", err)
	}
	if err := largeWriter.Close(); err != nil {
		return classify("multipart upload", err)
	}
	if err := assertLargeSSECWire(audit.since(beforeLarge), keyValue, keyMD5, keyID); err != nil {
		return err
	}
	largeAttrs, err := largeObject.Attrs(ctx, key)
	if err != nil {
		return classify("multipart metadata", err)
	}
	if got := largeAttrs.Info["sse_c_key_id"]; got != keyID {
		return failf("multipart metadata", "sse_c_key_id = %q, want caller key ID", got)
	}
	if err := assertSDKEncryption("multipart metadata", largeAttrs); err != nil {
		return err
	}
	largeGot, err := readAll(ctx, largeObject.NewReader(ctx, key))
	if err != nil {
		return classify("multipart download", err)
	}
	if !bytes.Equal(largeGot, largePayload) {
		return failf("multipart round trip", "the keyed multipart download bytes differ from the upload")
	}

	const rangeOffset, rangeLength = int64(1_234), int64(4_096)
	ranged := largeObject.NewRangeReader(ctx, rangeOffset, rangeLength, key)
	ranged.ConcurrentDownloads = 2
	ranged.ChunkSize = 1024
	rangeGot, err := readAll(ctx, ranged)
	if err != nil {
		return classify("ranged download", err)
	}
	wantRange := largePayload[rangeOffset : rangeOffset+rangeLength]
	if !bytes.Equal(rangeGot, wantRange) {
		mismatch := 0
		for mismatch < len(rangeGot) && mismatch < len(wantRange) && rangeGot[mismatch] == wantRange[mismatch] {
			mismatch++
		}
		return failf("ranged download", "the keyed ranged bytes differ from the requested slice (got %d bytes, want %d; first mismatch %d)", len(rangeGot), len(wantRange), mismatch)
	}

	versions, err := versionsOf(ctx, bucket, name)
	if err != nil || len(versions) != 1 {
		return failf("copy setup", "could not identify the sole source version")
	}
	copyName := objectName("sse-c-copy.bin")
	beforeCopy := audit.count()
	copyObject, err := bucket.Copy(ctx, versions[0].ID(), copyName,
		b2.CopySourceSSECKey(key), b2.CopyDestinationSSECKey(key))
	if err != nil {
		return classify("copy", err)
	}
	if err := assertKeyedCopy(audit.since(beforeCopy), keyValue, keyMD5); err != nil {
		return err
	}
	copyGot, err := readAll(ctx, copyObject.NewReader(ctx, key))
	if err != nil {
		return classify("copy download", err)
	}
	if !bytes.Equal(copyGot, payload) {
		return failf("copy", "the keyed copy bytes differ from the source")
	}
	copyAttrs, err := copyObject.Attrs(ctx, key)
	if err != nil {
		return classify("copy metadata", err)
	}
	if got := copyAttrs.Info["sse_c_key_id"]; got != keyID {
		return failf("copy metadata", "sse_c_key_id = %q, want caller key ID", got)
	}
	if err := assertSDKEncryption("copy metadata", copyAttrs); err != nil {
		return err
	}
	if err := assertInvalidSSECInfo(ctx, bucket, audit, key, rawKey, keyID); err != nil {
		return err
	}
	if err := assertUnsafeResumeRejected(ctx, baseURL, bucket, audit, key, keyValue, keyMD5, keyID); err != nil {
		return err
	}
	if err := assertPublicSSECMetadata(audit.since(0), keyValue); err != nil {
		return err
	}

	note("SSE-C start and every part carried the key; key IDs, public metadata, keyed reads/copy, unsafe resume and pre-request validation passed")
	return nil
}

func readAll(ctx context.Context, reader *b2.Reader) ([]byte, error) {
	data, readErr := io.ReadAll(reader)
	closeErr := reader.Close()
	if readErr != nil {
		return nil, readErr
	}
	if closeErr != nil {
		return nil, closeErr
	}
	return data, nil
}

type wireCall struct {
	method, path string
	headers      http.Header
	request      map[string]any
	response     map[string]any
	keyEchoed    bool
}

type wireAudit struct {
	mu    sync.Mutex
	key   string
	calls []wireCall
}

func (a *wireAudit) RoundTrip(req *http.Request) (*http.Response, error) {
	call := wireCall{method: req.Method, path: req.URL.Path, headers: req.Header.Clone()}
	if strings.HasSuffix(call.path, "/b2_start_large_file") || strings.HasSuffix(call.path, "/b2_copy_file") {
		body, err := io.ReadAll(req.Body)
		if err != nil {
			return nil, err
		}
		req.Body = io.NopCloser(bytes.NewReader(body))
		if err := json.Unmarshal(body, &call.request); err != nil {
			return nil, err
		}
	}
	resp, err := http.DefaultTransport.RoundTrip(req)
	if resp != nil {
		for _, values := range resp.Header {
			for _, value := range values {
				call.keyEchoed = call.keyEchoed || strings.Contains(value, a.key)
			}
		}
	}
	if resp != nil && strings.Contains(strings.ToLower(resp.Header.Get("Content-Type")), "json") {
		body, readErr := io.ReadAll(resp.Body)
		if readErr != nil {
			resp.Body.Close()
			return nil, readErr
		}
		resp.Body.Close()
		resp.Body = io.NopCloser(bytes.NewReader(body))
		call.keyEchoed = call.keyEchoed || bytes.Contains(body, []byte(a.key))
		if resp.StatusCode == http.StatusOK && strings.HasSuffix(call.path, "/b2_get_file_info") {
			if err := json.Unmarshal(body, &call.response); err != nil {
				return nil, err
			}
		}
	}
	a.mu.Lock()
	a.calls = append(a.calls, call)
	a.mu.Unlock()
	return resp, err
}

func (a *wireAudit) count() int {
	a.mu.Lock()
	defer a.mu.Unlock()
	return len(a.calls)
}

func (a *wireAudit) since(n int) []wireCall {
	a.mu.Lock()
	defer a.mu.Unlock()
	return append([]wireCall(nil), a.calls[n:]...)
}

func assertLargeSSECWire(calls []wireCall, key, digest, id string) error {
	starts, parts := 0, 0
	for _, call := range calls {
		switch {
		case strings.HasSuffix(call.path, "/b2_start_large_file"):
			starts++
			sse, _ := call.request["serverSideEncryption"].(map[string]any)
			if sse["mode"] != "SSE-C" || sse["algorithm"] != "AES256" || sse["customerKey"] != key || sse["customerKeyMd5"] != digest {
				return failf("multipart wire", "b2_start_large_file did not carry the requested SSE-C mode, algorithm, key and digest")
			}
			info, _ := call.request["fileInfo"].(map[string]any)
			if info["sse_c_key_id"] != id {
				return failf("multipart wire", "b2_start_large_file did not store the caller's sse_c_key_id")
			}
		case strings.HasSuffix(call.path, "/b2_upload_part"):
			parts++
			if call.headers.Get("X-Bz-Server-Side-Encryption-Customer-Algorithm") != "AES256" ||
				call.headers.Get("X-Bz-Server-Side-Encryption-Customer-Key") != key ||
				call.headers.Get("X-Bz-Server-Side-Encryption-Customer-Key-Md5") != digest {
				return failf("multipart wire", "b2_upload_part %d did not carry all three SSE-C headers", parts)
			}
		}
	}
	if starts != 1 || parts < 2 {
		return failf("multipart wire", "got %d start calls and %d part calls, want one start and at least two parts", starts, parts)
	}
	return nil
}

func assertPublicSSECMetadata(calls []wireCall, key string) error {
	seen := false
	for _, call := range calls {
		if call.keyEchoed {
			return failf("SSE-C metadata", "%s echoed the customer key in a response", call.path)
		}
		if !strings.HasSuffix(call.path, "/b2_get_file_info") || call.response == nil {
			continue
		}
		seen = true
		sse, _ := call.response["serverSideEncryption"].(map[string]any)
		if sse["customerKey"] != nil || sse["mode"] != "SSE-C" || sse["algorithm"] != "AES256" {
			return failf("multipart metadata", "want no customer key and SSE-C/AES256 mode and algorithm")
		}
		if md5, present := sse["customerKeyMd5"]; present {
			if digest, ok := md5.(string); !ok || digest == key {
				return failf("multipart metadata", "customerKeyMd5 must be a digest distinct from the customer key")
			}
		}
		// The B2-profile simulator mirrors a real-B2 response that also
		// reports the key MD5; it never returns the customer key itself.
		// https://github.com/backblaze-labs/b2-simulator/blob/main/bin/tests/test-sse-c-key-md5.mjs
		for field := range sse {
			switch field {
			case "mode", "algorithm", "customerKeyMd5":
			default:
				return failf("multipart metadata", "unexpected SSE field %q in response", field)
			}
		}
	}
	if !seen {
		return failf("multipart metadata", "no b2_get_file_info response was observed")
	}
	return nil
}

func assertSDKEncryption(step string, attrs *b2.Attrs) error {
	if attrs.ServerSideEncryption == nil || attrs.ServerSideEncryption.Mode != "SSE-C" || attrs.ServerSideEncryption.Algorithm != "AES256" {
		return failf(step, "blazer returned encryption %v, want SSE-C/AES256", attrs.ServerSideEncryption)
	}
	return nil
}

func assertKeyedRead(calls []wireCall, method, key, digest string) error {
	seen := false
	for _, call := range calls {
		if call.method != method || !strings.HasPrefix(call.path, "/file/") {
			continue
		}
		seen = true
		if call.headers.Get("X-Bz-Server-Side-Encryption-Customer-Algorithm") != "AES256" ||
			call.headers.Get("X-Bz-Server-Side-Encryption-Customer-Key") != key ||
			call.headers.Get("X-Bz-Server-Side-Encryption-Customer-Key-Md5") != digest {
			return failf("keyed read", "%s omitted a per-request SSE-C header", method)
		}
	}
	if !seen {
		return failf("keyed read", "no %s download-by-name request was observed", method)
	}
	return nil
}

func assertKeyedCopy(calls []wireCall, key, digest string) error {
	seen := false
	for _, call := range calls {
		if !strings.HasSuffix(call.path, "/b2_copy_file") {
			continue
		}
		seen = true
		for _, field := range []string{"sourceServerSideEncryption", "destinationServerSideEncryption"} {
			sse, _ := call.request[field].(map[string]any)
			if sse["mode"] != "SSE-C" || sse["algorithm"] != "AES256" || sse["customerKey"] != key || sse["customerKeyMd5"] != digest {
				return failf("keyed copy", "b2_copy_file did not carry the %s SSE-C key", field)
			}
		}
	}
	if !seen {
		return failf("keyed copy", "no b2_copy_file request was observed")
	}
	return nil
}

func assertInvalidSSECInfo(ctx context.Context, bucket *b2.Bucket, audit *wireAudit, key *b2.SSECKey, rawKey []byte, id string) error {
	plainKey, err := b2.NewSSECKey(rawKey)
	if err != nil {
		return failf("invalid info setup", "a valid key without ID was rejected")
	}
	atLimitInfo := make(map[string]string, 9)
	for i := 0; i < 9; i++ {
		atLimitInfo[fmt.Sprintf("entry_%d", i)] = "value"
	}
	atLimitObject := bucket.Object(objectName("ten-info-entries"))
	before := audit.count()
	atLimitWriter := atLimitObject.NewWriter(ctx,
		b2.WithSSECKey(key), b2.WithAttrsOption(&b2.Attrs{Info: atLimitInfo}))
	if _, err := atLimitWriter.Write([]byte("x")); err != nil {
		atLimitWriter.Close()
		return failf("file info limit", "nine caller entries plus key ID failed to write: %v", err)
	}
	if err := atLimitWriter.Close(); err != nil {
		return failf("file info limit", "nine caller entries plus key ID failed to close: %v", err)
	}
	if audit.count() == before {
		return failf("file info limit", "the accepted 10-entry upload sent no B2 request")
	}
	atLimitAttrs, err := atLimitObject.Attrs(ctx, key)
	if err != nil {
		return classify("file info limit metadata", err)
	}
	if len(atLimitAttrs.Info) != 10 || atLimitAttrs.Info["sse_c_key_id"] != id {
		return failf("file info limit", "stored %d file-info entries and key ID %q, want 10 entries including the caller key ID", len(atLimitAttrs.Info), atLimitAttrs.Info["sse_c_key_id"])
	}
	overLimitInfo := make(map[string]string, 10)
	for i := 0; i < 10; i++ {
		overLimitInfo[fmt.Sprintf("entry_%d", i)] = "value"
	}
	for _, test := range []struct {
		name string
		key  *b2.SSECKey
		info map[string]string
		data []byte
		want string
	}{
		{"lowercase-conflict", key, map[string]string{"sse_c_key_id": "other"}, []byte("x"), "conflicts"},
		{"uppercase-conflict", key, map[string]string{"SSE_C_KEY_ID": "other"}, []byte("x"), "conflicts"},
		{"mixedcase-conflict", key, map[string]string{"Sse_C_Key_Id": "other"}, []byte("x"), "conflicts"},
		{"id-without-key-id", plainKey, map[string]string{"sse_c_key_id": id}, []byte("x"), "requires a caller-supplied key ID"},
		{"eleven-info-entries-simple", key, overLimitInfo, []byte("x"), "10-entry file info limit"},
		{"eleven-info-entries", key, overLimitInfo, payloadOf(5_000_001), "10-entry file info limit"},
	} {
		before := audit.count()
		writer := bucket.Object(objectName("invalid-"+test.name)).NewWriter(ctx,
			b2.WithSSECKey(test.key), b2.WithAttrsOption(&b2.Attrs{Info: test.info}))
		writer.ChunkSize = 5_000_000
		_, writeErr := writer.Write(test.data)
		closeErr := writer.Close()
		gotErr := writeErr
		if gotErr == nil {
			gotErr = closeErr
		}
		if gotErr == nil || !strings.Contains(gotErr.Error(), test.want) {
			return failf("invalid info", "%s error = %v, want %s rejection", test.name, gotErr, test.want)
		}
		if got := audit.count(); got != before {
			return failf("invalid info", "%s sent %d B2 requests before rejection", test.name, got-before)
		}
	}
	return nil
}

func assertUnsafeResumeRejected(ctx context.Context, baseURL string, bucket *b2.Bucket, audit *wireAudit, key *b2.SSECKey, keyValue, digest, id string) error {
	for _, test := range []struct {
		name string
		info map[string]string
		key  *b2.SSECKey
		want string
	}{
		{"missing-id", nil, key, "identifier"},
		{"different-id", map[string]string{"sse_c_key_id": "another-id"}, key, "identifier"},
		{"unkeyed", map[string]string{"sse_c_key_id": id}, nil, "SSE-C key"},
	} {
		name := objectName("resume-" + test.name)
		if err := startUnfinishedSSEC(ctx, baseURL, bucket.ID(), name, test.info, keyValue, digest); err != nil {
			return classify("resume setup", err)
		}
		before := audit.count()
		var opts []b2.WriterOption
		if test.key != nil {
			opts = append(opts, b2.WithSSECKey(test.key))
		}
		writer := bucket.Object(name).NewWriter(ctx, opts...)
		writer.Resume = true
		writer.ChunkSize = 5_000_000
		_, writeErr := writer.Write(payloadOf(5_000_001))
		closeErr := writer.Close()
		gotErr := writeErr
		if gotErr == nil {
			gotErr = closeErr
		}
		if gotErr == nil || !strings.Contains(gotErr.Error(), test.want) {
			return failf("resume", "%s: error = %v, want %s rejection", test.name, gotErr, test.want)
		}
		for _, call := range audit.since(before) {
			if strings.HasSuffix(call.path, "/b2_start_large_file") || strings.HasSuffix(call.path, "/b2_upload_part") {
				return failf("resume", "%s sent an upload request after rejecting the unsafe resume", test.name)
			}
		}
	}
	return nil
}

func startUnfinishedSSEC(ctx context.Context, baseURL, bucketID, name string, info map[string]string, key, digest string) error {
	authReq, err := http.NewRequestWithContext(ctx, http.MethodGet, baseURL+"/b2api/v4/b2_authorize_account", nil)
	if err != nil {
		return err
	}
	authReq.SetBasicAuth("test-key-id", "test-key")
	authResp, err := http.DefaultClient.Do(authReq)
	if err != nil {
		return err
	}
	var auth struct {
		AuthorizationToken string `json:"authorizationToken"`
	}
	err = json.NewDecoder(authResp.Body).Decode(&auth)
	authResp.Body.Close()
	if err != nil || authResp.StatusCode != http.StatusOK || auth.AuthorizationToken == "" {
		return fmt.Errorf("fixture authorization failed with status %d", authResp.StatusCode)
	}
	body, err := json.Marshal(map[string]any{
		"bucketId": bucketID, "fileName": name, "contentType": "application/octet-stream", "fileInfo": info,
		"serverSideEncryption": map[string]string{"mode": "SSE-C", "algorithm": "AES256", "customerKey": key, "customerKeyMd5": digest},
	})
	if err != nil {
		return err
	}
	startReq, err := http.NewRequestWithContext(ctx, http.MethodPost, baseURL+"/b2api/v4/b2_start_large_file", bytes.NewReader(body))
	if err != nil {
		return err
	}
	startReq.Header.Set("Authorization", auth.AuthorizationToken)
	startReq.Header.Set("Content-Type", "application/json")
	startResp, err := http.DefaultClient.Do(startReq)
	if err != nil {
		return err
	}
	startResp.Body.Close()
	if startResp.StatusCode != http.StatusOK {
		return fmt.Errorf("fixture b2_start_large_file returned status %d", startResp.StatusCode)
	}
	return nil
}

// ---------------------------------------------------------------------------
// Shared plumbing. Identical in every blazer check; the scenario above is the
// only part that differs. Contract: bin/conformance/README.md.
// ---------------------------------------------------------------------------

const slug = "blazer"

// The closed reason set, mirrored from bin/conformance/README.md. The runner
// enforces it; a reason outside it is a FAIL the runner manufactures.
const (
	reasonNoRealm   = "no-realm-option"
	reasonUnreach   = "unreachable"
	reasonUnauth    = "unauthorized"
	reasonNoCred    = "no-credential"
	reasonNoRuntime = "missing-runtime"
	reasonNotClaim  = "not-claimed"
)

// amberErr: the question could not be asked. failErr: it was asked, and the
// answer contradicts the card.
type amberErr struct{ reason, detail string }

func (e *amberErr) Error() string { return e.reason + ": " + e.detail }

type failErr struct{ step, detail string }

func (e *failErr) Error() string { return e.step + ": " + e.detail }

func amberf(reason, format string, args ...interface{}) error {
	return &amberErr{reason: reason, detail: scrub(fmt.Sprintf(format, args...))}
}

func failf(step, format string, args ...interface{}) error {
	return &failErr{step: step, detail: scrub(fmt.Sprintf(format, args...))}
}

// secretsToScrub holds every value that must never reach stdout: the key id,
// the application key, and any download token this check mints.
var secretsToScrub []string

// opaqueToken matches anything long and token-shaped. A detail never needs a
// 25-character opaque string, and a leaked credential is far worse than a
// vague detail.
var opaqueToken = regexp.MustCompile(`[A-Za-z0-9+/=_-]{25,}`)

func scrub(s string) string { return scrubTo(s, 180) }

// scrubTo is scrub with a caller-chosen cap: a result-line detail stays short,
// while a NOTE may carry the evidence it is there to carry.
func scrubTo(s string, limit int) string {
	for _, secret := range secretsToScrub {
		if secret != "" {
			s = strings.Replace(s, secret, "REDACTED", -1)
		}
	}
	s = strings.Join(strings.Fields(s), " ")
	s = opaqueToken.ReplaceAllString(s, "REDACTED")
	if len(s) > limit {
		s = s[:limit] + "..."
	}
	return s
}

// classify turns an error into a FAIL. This check only runs when the harness
// handed it a loopback simulator URL, so a 401/403, a refused connection, a
// deadline or a reset is the simulator or blazer misbehaving (an auth, hang or
// retry regression), never a legitimate environment problem. Only a missing Go
// toolchain or dependency is COULD-NOT-RUN, and that is decided before this
// program exists (sdkharness_go_build in lib/contract.sh).
func classify(step string, err error) error {
	if err == nil {
		return nil
	}
	switch err.(type) {
	case *amberErr, *failErr:
		return err
	}
	return failf(step, "%s", err.Error())
}

func say(target, verdict string) {
	fmt.Printf("CONFORMANCE %s %s @%s: %s\n", slug, capability, target, verdict)
}

// note carries evidence that is weaker than the assertion it supports. It is a
// SEPARATE line on purpose: the runner parses `PASS` exactly, so a PASS may
// never carry a detail.
func note(format string, args ...interface{}) {
	fmt.Printf("NOTE %s %s: %s\n", slug, capability, scrubTo(fmt.Sprintf(format, args...), 600))
}

func requestedTarget() string {
	if t := os.Getenv("CONFORMANCE_TARGET"); t != "" {
		return t
	}
	return "simulator"
}

// apiBase maps a requested target onto a realm blazer can reach. `simulator` is
// the harness's own server (bin/simulator/serve.mjs), whose URL the runner
// exports as CONFORMANCE_SIMULATOR_URL and blazer reaches through b2.APIBase;
// unset, there is nothing to reach: no-realm-option.
func apiBase(target string) (string, error) {
	if target == "simulator" {
		if url := os.Getenv("CONFORMANCE_SIMULATOR_URL"); url != "" {
			return url, nil
		}
		return "", amberf(reasonNoRealm, "CONFORMANCE_SIMULATOR_URL is unset")
	}
	return "", amberf(reasonNoRealm, "blazer checks run only against the loopback simulator, not %q", target)
}

// credentials at @simulator is the simulator's fixed test credential, so a real
// B2_* value can never be sent there.
func credentials(target string) (string, string, error) {
	if target == "simulator" {
		return "test-key-id", "test-key", nil
	}
	return "", "", amberf(reasonNoRealm, "blazer checks use only the simulator's fixed test credential")
}

func newClient(ctx context.Context, target string) (*b2.Client, error) {
	base, err := apiBase(target)
	if err != nil {
		return nil, err
	}
	id, key, err := credentials(target)
	if err != nil {
		return nil, err
	}
	client, err := b2.NewClient(ctx, id, key, b2.APIBase(base), b2.UserAgent("sdkharness-conformance/blazer"))
	if err != nil {
		return nil, classify("authenticate", err)
	}
	return client, nil
}

func randomHex(n int) string {
	buf := make([]byte, n)
	if _, err := rand.Read(buf); err != nil {
		return strings.Repeat("0", 2*n)
	}
	return hex.EncodeToString(buf)
}

func bucketName() string { return "sdkharness-conf-" + randomHex(6) }

func objectName(leaf string) string { return "st/" + leaf }

func sha1hex(payload []byte) string {
	sum := sha1.Sum(payload)
	return hex.EncodeToString(sum[:])
}

// payloadOf returns n deterministic-but-incompressible-enough bytes.
func payloadOf(n int) []byte {
	seed := []byte("sdkharness conformance blazer payload ")
	buf := make([]byte, n)
	for i := range buf {
		buf[i] = seed[i%len(seed)] ^ byte(i*31)
	}
	return buf
}

// newBucket creates an ephemeral bucket and returns a cleanup that empties and
// removes it. A check owns every resource it creates and destroys all of them,
// on the error path too -- hence the returned func is always deferred.
func newBucket(ctx context.Context, client *b2.Client, attrs *b2.BucketAttrs) (*b2.Bucket, func(), error) {
	if attrs == nil {
		attrs = &b2.BucketAttrs{Type: b2.Private}
	}
	bucket, err := client.NewBucket(ctx, bucketName(), attrs)
	if err != nil {
		return nil, func() {}, classify("create bucket", err)
	}
	return bucket, func() { destroyBucket(ctx, bucket) }, nil
}

func destroyBucket(ctx context.Context, bucket *b2.Bucket) {
	for attempt := 0; attempt < 2; attempt++ {
		emptyBucket(ctx, bucket)
		if err := bucket.Delete(ctx); err == nil {
			return
		} else if attempt == 1 {
			// Never mask the verdict with a cleanup failure -- say it and move on.
			note("cleanup left bucket %s behind: %s", bucket.Name(), scrub(err.Error()))
		}
	}
}

func emptyBucket(ctx context.Context, bucket *b2.Bucket) {
	iter := bucket.List(ctx, b2.ListHidden())
	for iter.Next() {
		iter.Object().Delete(ctx)
	}
	unfinished := bucket.List(ctx, b2.ListUnfinished())
	for unfinished.Next() {
		unfinished.Object().Cancel(ctx)
	}
}

// upload writes payload to name. tune runs before the first Write, because
// blazer requires Writer fields to be set before then.
func upload(ctx context.Context, bucket *b2.Bucket, name string, payload []byte, attrs *b2.Attrs, tune func(*b2.Writer)) (*b2.Object, error) {
	object := bucket.Object(name)
	var opts []b2.WriterOption
	if attrs != nil {
		opts = append(opts, b2.WithAttrsOption(attrs))
	}
	writer := object.NewWriter(ctx, opts...)
	if tune != nil {
		tune(writer)
	}
	if _, err := writer.Write(payload); err != nil {
		writer.Close()
		return nil, classify("upload", err)
	}
	if err := writer.Close(); err != nil {
		return nil, classify("upload", err)
	}
	return object, nil
}

func download(ctx context.Context, bucket *b2.Bucket, name string, tune func(*b2.Reader)) ([]byte, error) {
	reader := bucket.Object(name).NewReader(ctx)
	if tune != nil {
		tune(reader)
	}
	data, readErr := io.ReadAll(reader)
	closeErr := reader.Close()
	if readErr != nil {
		return nil, classify("download", readErr)
	}
	if closeErr != nil {
		return nil, classify("download", closeErr)
	}
	return data, nil
}

// versionsOf returns every listed version of name, newest first. It is also the
// only way to obtain a fileId here: blazer implements neither
// b2_get_file_info_by_name nor b2_download_file_by_id (card.md, raw-endpoint
// table), so a by-name Object reference carries no id.
func versionsOf(ctx context.Context, bucket *b2.Bucket, name string) ([]*b2.Object, error) {
	var found []*b2.Object
	iter := bucket.List(ctx, b2.ListPrefix(name), b2.ListHidden())
	for iter.Next() {
		if iter.Object().Name() == name {
			found = append(found, iter.Object())
		}
	}
	if err := iter.Err(); err != nil {
		return nil, classify("list versions", err)
	}
	return found, nil
}

func namesUnder(ctx context.Context, bucket *b2.Bucket, prefix string) ([]string, error) {
	var names []string
	iter := bucket.List(ctx, b2.ListPrefix(prefix))
	for iter.Next() {
		names = append(names, iter.Object().Name())
	}
	if err := iter.Err(); err != nil {
		return nil, classify("list", err)
	}
	return names, nil
}

// rpcCounts sums blazer's per-method RPC counters across every window it
// reports (b2/monitor.go, surfaced by Client.Status). The windows overlap, so
// the absolute numbers mean nothing; "was this method called between two
// reads" -- which is what the boundary assertions use -- is sound.
func rpcCounts(client *b2.Client) map[string]int {
	counts := map[string]int{}
	info := client.Status()
	if info == nil {
		return counts
	}
	for _, methods := range info.RPCs {
		for name, n := range methods.CountByMethod() {
			counts[name] += n
		}
	}
	return counts
}

func rpcDelta(before, after map[string]int) []string {
	var moved []string
	for name, n := range after {
		if n > before[name] {
			moved = append(moved, name)
		}
	}
	sort.Strings(moved)
	return moved
}

func anyContains(values []string, substr string) bool {
	for _, value := range values {
		if strings.Contains(strings.ToLower(value), substr) {
			return true
		}
	}
	return false
}

// exportedFields names a struct's exported fields, which is how the ⚠ boundary
// assertions interrogate the PUBLISHED package rather than trusting the card.
func exportedFields(v interface{}) []string {
	var names []string
	t := reflect.TypeOf(v)
	for t.Kind() == reflect.Ptr {
		t = t.Elem()
	}
	if t.Kind() != reflect.Struct {
		return names
	}
	for i := 0; i < t.NumField(); i++ {
		if field := t.Field(i); field.PkgPath == "" {
			names = append(names, field.Name)
		}
	}
	sort.Strings(names)
	return names
}

func infoValue(info map[string]string, key string) (string, bool) {
	for k, v := range info {
		if strings.EqualFold(k, key) {
			return v, true
		}
	}
	return "", false
}

func main() {
	target := requestedTarget()
	defer func() {
		if r := recover(); r != nil {
			say(target, fmt.Sprintf("FAIL (panic -- %s)", scrub(fmt.Sprint(r))))
			os.Exit(1)
		}
	}()
	err := runCheck(context.Background(), &target)
	switch e := err.(type) {
	case nil:
		say(target, "PASS")
	case *amberErr:
		say(target, fmt.Sprintf("COULD-NOT-RUN (%s -- %s)", e.reason, e.detail))
	case *failErr:
		say(target, fmt.Sprintf("FAIL (%s -- %s)", e.step, e.detail))
		os.Exit(1)
	default:
		say(target, fmt.Sprintf("FAIL (check -- %s)", scrub(err.Error())))
		os.Exit(1)
	}
}
__EOF_GO__
