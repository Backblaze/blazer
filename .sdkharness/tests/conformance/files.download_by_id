#!/usr/bin/env bash
# CONFORMANCE blazer x files.download_by_id -- the contract is bin/conformance/README.md.
#
# Scenario: exact-version downloads, low-level GET/HEAD/range, ID-safe logs,
# and preservation of gzip-encoded stored bytes.
#
# The expected values are B2's published contract. b2_download_file_by_id
# "Downloads one file using a file ID", and its response
# headers, Content-Length and X-Bz-Content-Sha1 among them, "contain the same
# information they did when the file was uploaded".
# https://www.backblaze.com/apidocs/b2-download-file-by-id
# https://github.com/Backblaze/blazer/releases/tag/v0.10.0
#
# Exercises the checked-out github.com/Backblaze/blazer module through a local Go `replace`; the orchestrator selects the exact clean revision. The scenario semantics came from the fleet card and B2 API documentation.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd -P)"

SLUG=blazer
CAP=files.download_by_id
TARGET=simulator

say() { printf 'CONFORMANCE %s %s @%s: %s\n' "$SLUG" "$CAP" "$1" "$2"; }

# A detail never carries a response body, a multi-line diagnostic or a
# credential: one line, printable, capped.
tidy_detail() { printf '%s' "$1" | tr '\n\r\t' '   ' | tr -cd '[:print:]' | cut -c1-200; }

. "$(dirname "$0")/../lib/contract.sh"
if ! sdkharness_leaf_guard CONFORMANCE_TARGET CONFORMANCE_SIMULATOR_URL; then
  say simulator "FAIL ($SDKHARNESS_GUARD_REASON)"
  exit 1
fi
sdkharness_go_offline_env

if ! command -v go >/dev/null 2>&1; then
  say "$TARGET" "COULD-NOT-RUN (missing-runtime -- no Go toolchain on PATH)"
  exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-conf-blazer.XXXXXX")" || {
  say "$TARGET" "FAIL (setup -- could not create a scratch directory)"
  exit 1
}
trap 'rm -rf "$work"' EXIT HUP INT TERM

# The Go program is carried at the end of this file as an INERT heredoc, so
# `bash -n` parses this check as the shell script it is rather than choking on
# Go syntax.
awk '/^__EOF_GO__$/ { inprog = 0 } inprog { print } /^: <</ { inprog = 1 }' "$0" > "$work/main.go"
cat > "$work/go.mod" <<EOF
module sdkharness-conformance-blazer

go 1.18

require github.com/Backblaze/blazer v0.8.0

replace github.com/Backblaze/blazer => $REPO_ROOT
EOF


# Build and run are deliberately separate, and only a missing or unusable Go
# toolchain is an ABSENT RUNTIME (amber). A module that does not compile, a
# failing `go mod tidy` and a missing dependency are all a defect in blazer or
# in this check (red): hiding them as amber would turn a regression into
# harmless evidence. sdkharness_go_build (lib/contract.sh) draws that line.
cp "$(dirname "$0")/../lib/loopback_guard.go.txt" "$work/loopback_guard.go"
sdkharness_go_build "$work" check
case "$?" in
  0) ;;
  10) say "$TARGET" "COULD-NOT-RUN (missing-runtime -- $SDKHARNESS_BUILD_REASON)"; exit 0 ;;
  *) say "$TARGET" "FAIL (build -- blazer or this check did not compile offline: $(tidy_detail "$SDKHARNESS_BUILD_OUT"))"; exit 1 ;;
esac

run_out="$(B2_LOG_LEVEL=2 "$work/check" 2>&1)"
run_rc=$?

printf '%s\n' "$run_out" | grep -E '^NOTE ' || true
line="$(printf '%s\n' "$run_out" | grep -E "^CONFORMANCE $SLUG $CAP @" | tail -1)"
if [ -z "$line" ]; then
	# Never echo captured debug output or a panic that might contain a file ID.
	say "$TARGET" "FAIL (harness -- the check binary produced no result line)"
  exit 1
fi
printf '%s\n' "$line"
exit "$run_rc"

: <<'__EOF_GO__'
package main

// blazer x files.download_by_id.
//
// Setup   a fixture object
// Action  download it by file ID
// Assert  byte-identical, length matches
//
// The API came from docs/sdks/blazer/card.md and godoc for
// github.com/Backblaze/blazer/b2. Never from b2sdks/.

import (
	"bytes"
	"compress/gzip"
	"context"
	"crypto/rand"
	"crypto/sha1"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net/http"
	"net/url"
	"os"
	"reflect"
	"regexp"
	"sort"
	"strings"
	"sync"

	"github.com/Backblaze/blazer/b2"
	"github.com/Backblaze/blazer/base"
)

const capability = "files.download_by_id"

func runCheck(ctx context.Context, target *string) error {
	previousOutput := log.Writer()
	log.SetOutput(io.Discard)
	defer log.SetOutput(previousOutput)
	origin, err := apiBase(*target)
	if err != nil {
		return err
	}
	keyID, key, err := credentials(*target)
	if err != nil {
		return err
	}
	audit := &downloadAudit{}
	client, err := b2.NewClient(ctx, keyID, key, b2.APIBase(origin), b2.Transport(audit))
	if err != nil {
		return classify("authenticate", err)
	}

	payload := payloadOf(64 * 1024)
	name := objectName("download.bin")

	bucket, cleanup, err := newBucket(ctx, client, nil)
	if err != nil {
		return err
	}
	defer cleanup()

	old, err := upload(ctx, bucket, name, payload, nil, nil)
	if err != nil {
		return err
	}
	currentPayload := []byte("a distinct current version")
	current, err := upload(ctx, bucket, name, currentPayload, nil, nil)
	if err != nil {
		return err
	}
	if old.ID() == "" || current.ID() == "" || old.ID() == current.ID() {
		return failf("versions", "uploads did not produce two distinct file IDs")
	}
	secretsToScrub = append(secretsToScrub, old.ID(), current.ID())

	var compressed bytes.Buffer
	zip := gzip.NewWriter(&compressed)
	if _, err := zip.Write([]byte("stored gzip bytes must not be decompressed")); err != nil {
		return classify("gzip fixture", err)
	}
	if err := zip.Close(); err != nil {
		return classify("gzip fixture", err)
	}
	gzipObject, err := upload(ctx, bucket, objectName("encoded.gz"), compressed.Bytes(),
		&b2.Attrs{Info: map[string]string{"b2-content-encoding": "gzip"}}, nil)
	if err != nil {
		return err
	}
	if gzipObject.ID() == "" {
		return failf("gzip fixture", "upload returned no file ID")
	}
	secretsToScrub = append(secretsToScrub, gzipObject.ID())

	// A keyless read of this encrypted fixture produces a real B2-shaped JSON
	// error from the simulator. The audit adds the ID to its message to exercise
	// error redaction without changing the simulator's status or error code.
	sseKey, err := b2.NewSSECKey(bytes.Repeat([]byte{0x42}, 32))
	if err != nil {
		return classify("SSE-C fixture", err)
	}
	encrypted := bucket.Object(objectName("encrypted.bin"))
	w := encrypted.NewWriter(ctx, b2.WithSSECKey(sseKey))
	if _, err := w.Write([]byte("encrypted fixture")); err != nil {
		_ = w.Close()
		return classify("SSE-C fixture", err)
	}
	if err := w.Close(); err != nil {
		return classify("SSE-C fixture", err)
	}
	if encrypted.ID() == "" {
		return failf("SSE-C fixture", "upload returned no file ID")
	}
	secretsToScrub = append(secretsToScrub, encrypted.ID())

	low, err := base.AuthorizeAccount(ctx, keyID, key, base.SetAPIBase(origin), base.Transport(audit))
	if err != nil {
		return classify("base authorize", err)
	}
	buckets, err := low.ListBuckets(ctx, bucket.Name())
	if err != nil {
		return classify("base bucket", err)
	}
	if len(buckets) != 1 || buckets[0].ID != bucket.ID() {
		return failf("base bucket", "could not resolve the fixture bucket")
	}
	lowBucket := buckets[0]

	var logs bytes.Buffer
	log.SetOutput(&logs)
	defer log.SetOutput(io.Discard) // Cleanup may log unrelated file-version IDs.
	for _, tc := range []struct {
		name, id string
		want     []byte
	}{
		{"historical", old.ID(), payload}, {"current", current.ID(), currentPayload},
		{"gzip", gzipObject.ID(), compressed.Bytes()},
	} {
		reader, err := bucket.DownloadFileByID(ctx, tc.id)
		if err != nil {
			return classify(tc.name+" high-level download", err)
		}
		got, readErr := io.ReadAll(reader)
		closeErr := reader.Close()
		if readErr != nil {
			return classify(tc.name+" high-level read", readErr)
		}
		if closeErr != nil {
			return classify(tc.name+" high-level close", closeErr)
		}
		if !bytes.Equal(got, tc.want) {
			return failf(tc.name+" high-level download", "returned bytes differ from the stored version")
		}
	}
	for _, tc := range []struct {
		name         string
		offset, size int64
		head         bool
		want         []byte
		length       int
	}{
		{"GET", 0, 0, false, payload, len(payload)},
		{"HEAD", 0, 0, true, nil, len(payload)},
		{"range", 7, 29, false, payload[7:36], 29},
	} {
		reader, err := lowBucket.DownloadFileByID(ctx, old.ID(), tc.offset, tc.size, tc.head)
		if err != nil {
			return classify(tc.name+" base download", err)
		}
		got, readErr := io.ReadAll(reader)
		closeErr := reader.Close()
		if readErr != nil {
			return classify(tc.name+" base read", readErr)
		}
		if closeErr != nil {
			return classify(tc.name+" base close", closeErr)
		}
		if !bytes.Equal(got, tc.want) || reader.ContentLength != tc.length || reader.ID != old.ID() || reader.SHA1 != sha1hex(payload) {
			return failf(tc.name+" base download", "bytes or version metadata differ from the expected historical version")
		}
	}
	gzipReader, err := lowBucket.DownloadFileByID(ctx, gzipObject.ID(), 0, 0, false)
	if err != nil {
		return classify("gzip base download", err)
	}
	gzipBytes, readErr := io.ReadAll(gzipReader)
	closeErr := gzipReader.Close()
	if readErr != nil {
		return classify("gzip base read", readErr)
	}
	if closeErr != nil {
		return classify("gzip base close", closeErr)
	}
	if !bytes.Equal(gzipBytes, compressed.Bytes()) || gzipReader.ContentLength != compressed.Len() || gzipReader.SHA1 != sha1hex(compressed.Bytes()) {
		return failf("gzip base download", "stored bytes, length or SHA1 changed")
	}

	audit.injectID = encrypted.ID()
	_, err = lowBucket.DownloadFileByID(ctx, encrypted.ID(), 0, 0, false)
	status, code, _ := base.MsgCode(err)
	if err == nil || status != http.StatusBadRequest || code != "bad_request" || !audit.injected {
		return failf("error metadata", "expected the simulator's 400 bad_request for a keyless SSE-C read")
	}
	if strings.Contains(err.Error(), encrypted.ID()) || !strings.Contains(err.Error(), "[REDACTED]") {
		return failf("error redaction", "the ID-bearing error was not redacted")
	}
	// Consumers can retain the status and B2 code when logging the safe error.
	log.Printf("download error status=%d code=%s: %v", status, code, err)
	if !strings.Contains(logs.String(), "status=400 code=bad_request") {
		return failf("error logging", "HTTP status and B2 error code were not visible")
	}
	if err := audit.check(old.ID(), gzipObject.ID()); err != nil {
		return err
	}
	for _, id := range []string{old.ID(), current.ID(), gzipObject.ID(), encrypted.ID()} {
		if strings.Contains(logs.String(), id) || strings.Contains(logs.String(), url.QueryEscape(id)) {
			return failf("log redaction", "a download log exposed a file ID")
		}
	}
	if !strings.Contains(logs.String(), ">> b2_download_file_by_id GET") ||
		!strings.Contains(logs.String(), ">> b2_download_file_by_id HEAD") ||
		!strings.Contains(logs.String(), "<< b2_download_file_by_id status=400") {
		return failf("debug logging", "expected GET, HEAD and error status log entries")
	}
	note("current and historical bytes, GET/HEAD/range, gzip and ID-safe debug/error logs verified")
	return nil
}

type downloadRequest struct {
	id, method, byteRange, acceptEncoding, contentEncoding string
	status                                                 int
}

type downloadAudit struct {
	mu       sync.Mutex
	requests []downloadRequest
	injectID string
	injected bool
}

func (a *downloadAudit) RoundTrip(req *http.Request) (*http.Response, error) {
	resp, err := http.DefaultTransport.RoundTrip(req)
	if err != nil || !strings.HasSuffix(req.URL.Path, "/b2_download_file_by_id") {
		return resp, err
	}
	id := req.URL.Query().Get("fileId")
	a.mu.Lock()
	defer a.mu.Unlock()
	a.requests = append(a.requests, downloadRequest{id: id, method: req.Method, byteRange: req.Header.Get("Range"),
		acceptEncoding: req.Header.Get("Accept-Encoding"), contentEncoding: resp.Header.Get("Content-Encoding"), status: resp.StatusCode})
	if id == a.injectID && resp.StatusCode == http.StatusBadRequest {
		body, err := io.ReadAll(resp.Body)
		_ = resp.Body.Close()
		if err != nil {
			return nil, err
		}
		var message struct {
			Status  int    `json:"status"`
			Code    string `json:"code"`
			Message string `json:"message"`
		}
		if err := json.Unmarshal(body, &message); err != nil {
			return nil, err
		}
		if message.Status != http.StatusBadRequest || message.Code != "bad_request" {
			return nil, fmt.Errorf("unexpected simulator error")
		}
		message.Message += " file ID " + id + " URL " + req.URL.String()
		body, err = json.Marshal(message)
		if err != nil {
			return nil, err
		}
		resp.Body = io.NopCloser(bytes.NewReader(body))
		resp.ContentLength = int64(len(body))
		resp.Header.Set("Content-Length", fmt.Sprint(len(body)))
		a.injected = true
	}
	return resp, nil
}

func (a *downloadAudit) check(oldID, gzipID string) error {
	a.mu.Lock()
	defer a.mu.Unlock()
	get, head, ranged, gzipGets := false, false, false, 0
	for _, request := range a.requests {
		if request.id == oldID && request.method == http.MethodGet && request.byteRange == "" && request.status == http.StatusOK {
			get = true
		}
		if request.id == oldID && request.method == http.MethodHead && request.byteRange == "" && request.status == http.StatusOK {
			head = true
		}
		if request.id == oldID && request.method == http.MethodGet && request.byteRange == "bytes=7-35" && request.status == http.StatusPartialContent {
			ranged = true
		}
		if request.id == gzipID && request.method == http.MethodGet && request.acceptEncoding == "identity" && request.contentEncoding == "gzip" && request.status == http.StatusOK {
			gzipGets++
		}
	}
	if !get || !head || !ranged || gzipGets != 2 {
		return failf("wire evidence", "GET, HEAD, range or two identity-encoded gzip requests were missing")
	}
	return nil
}

// ---------------------------------------------------------------------------
// Shared plumbing. Identical in every blazer check; the scenario above is the
// only part that differs. Contract: bin/conformance/README.md.
// ---------------------------------------------------------------------------

const slug = "blazer"

// The closed reason set, mirrored from bin/conformance/README.md. The runner
// enforces it; a reason outside it is a FAIL the runner manufactures.
const (
	reasonNoRealm   = "no-realm-option"
	reasonUnreach   = "unreachable"
	reasonUnauth    = "unauthorized"
	reasonNoCred    = "no-credential"
	reasonNoRuntime = "missing-runtime"
	reasonNotClaim  = "not-claimed"
)

// amberErr: the question could not be asked. failErr: it was asked, and the
// answer contradicts the card.
type amberErr struct{ reason, detail string }

func (e *amberErr) Error() string { return e.reason + ": " + e.detail }

type failErr struct{ step, detail string }

func (e *failErr) Error() string { return e.step + ": " + e.detail }

func amberf(reason, format string, args ...interface{}) error {
	return &amberErr{reason: reason, detail: scrub(fmt.Sprintf(format, args...))}
}

func failf(step, format string, args ...interface{}) error {
	return &failErr{step: step, detail: scrub(fmt.Sprintf(format, args...))}
}

// secretsToScrub holds every value that must never reach stdout: the key id,
// the application key, and any download token this check mints.
var secretsToScrub []string

// opaqueToken matches anything long and token-shaped. A detail never needs a
// 25-character opaque string, and a leaked credential is far worse than a
// vague detail.
var opaqueToken = regexp.MustCompile(`[A-Za-z0-9+/=_-]{25,}`)

func scrub(s string) string { return scrubTo(s, 180) }

// scrubTo is scrub with a caller-chosen cap: a result-line detail stays short,
// while a NOTE may carry the evidence it is there to carry.
func scrubTo(s string, limit int) string {
	for _, secret := range secretsToScrub {
		if secret != "" {
			s = strings.Replace(s, secret, "REDACTED", -1)
		}
	}
	s = strings.Join(strings.Fields(s), " ")
	s = opaqueToken.ReplaceAllString(s, "REDACTED")
	if len(s) > limit {
		s = s[:limit] + "..."
	}
	return s
}

// classify turns an error into a FAIL. This check only runs when the harness
// handed it a loopback simulator URL, so a 401/403, a refused connection, a
// deadline or a reset is the simulator or blazer misbehaving (an auth, hang or
// retry regression), never a legitimate environment problem. Only a missing Go
// toolchain or dependency is COULD-NOT-RUN, and that is decided before this
// program exists (sdkharness_go_build in lib/contract.sh).
func classify(step string, err error) error {
	if err == nil {
		return nil
	}
	switch err.(type) {
	case *amberErr, *failErr:
		return err
	}
	return failf(step, "%s", err.Error())
}

func say(target, verdict string) {
	fmt.Printf("CONFORMANCE %s %s @%s: %s\n", slug, capability, target, verdict)
}

// note carries evidence that is weaker than the assertion it supports. It is a
// SEPARATE line on purpose: the runner parses `PASS` exactly, so a PASS may
// never carry a detail.
func note(format string, args ...interface{}) {
	fmt.Printf("NOTE %s %s: %s\n", slug, capability, scrubTo(fmt.Sprintf(format, args...), 600))
}

func requestedTarget() string {
	if t := os.Getenv("CONFORMANCE_TARGET"); t != "" {
		return t
	}
	return "simulator"
}

// apiBase maps a requested target onto a realm blazer can reach. `simulator` is
// the harness's own server (bin/simulator/serve.mjs), whose URL the runner
// exports as CONFORMANCE_SIMULATOR_URL and blazer reaches through b2.APIBase;
// unset, there is nothing to reach: no-realm-option.
func apiBase(target string) (string, error) {
	if target == "simulator" {
		if url := os.Getenv("CONFORMANCE_SIMULATOR_URL"); url != "" {
			return url, nil
		}
		return "", amberf(reasonNoRealm, "CONFORMANCE_SIMULATOR_URL is unset")
	}
	return "", amberf(reasonNoRealm, "blazer checks run only against the loopback simulator, not %q", target)
}

// credentials at @simulator is the simulator's fixed test credential, so a real
// B2_* value can never be sent there.
func credentials(target string) (string, string, error) {
	if target == "simulator" {
		return "test-key-id", "test-key", nil
	}
	return "", "", amberf(reasonNoRealm, "blazer checks use only the simulator's fixed test credential")
}

func newClient(ctx context.Context, target string) (*b2.Client, error) {
	base, err := apiBase(target)
	if err != nil {
		return nil, err
	}
	id, key, err := credentials(target)
	if err != nil {
		return nil, err
	}
	client, err := b2.NewClient(ctx, id, key, b2.APIBase(base), b2.UserAgent("sdkharness-conformance/blazer"))
	if err != nil {
		return nil, classify("authenticate", err)
	}
	return client, nil
}

func randomHex(n int) string {
	buf := make([]byte, n)
	if _, err := rand.Read(buf); err != nil {
		return strings.Repeat("0", 2*n)
	}
	return hex.EncodeToString(buf)
}

func bucketName() string { return "sdkharness-conf-" + randomHex(6) }

func objectName(leaf string) string { return "st/" + leaf }

func sha1hex(payload []byte) string {
	sum := sha1.Sum(payload)
	return hex.EncodeToString(sum[:])
}

// payloadOf returns n deterministic-but-incompressible-enough bytes.
func payloadOf(n int) []byte {
	seed := []byte("sdkharness conformance blazer payload ")
	buf := make([]byte, n)
	for i := range buf {
		buf[i] = seed[i%len(seed)] ^ byte(i*31)
	}
	return buf
}

// newBucket creates an ephemeral bucket and returns a cleanup that empties and
// removes it. A check owns every resource it creates and destroys all of them,
// on the error path too -- hence the returned func is always deferred.
func newBucket(ctx context.Context, client *b2.Client, attrs *b2.BucketAttrs) (*b2.Bucket, func(), error) {
	if attrs == nil {
		attrs = &b2.BucketAttrs{Type: b2.Private}
	}
	bucket, err := client.NewBucket(ctx, bucketName(), attrs)
	if err != nil {
		return nil, func() {}, classify("create bucket", err)
	}
	return bucket, func() { destroyBucket(ctx, bucket) }, nil
}

func destroyBucket(ctx context.Context, bucket *b2.Bucket) {
	for attempt := 0; attempt < 2; attempt++ {
		emptyBucket(ctx, bucket)
		if err := bucket.Delete(ctx); err == nil {
			return
		} else if attempt == 1 {
			// Never mask the verdict with a cleanup failure -- say it and move on.
			note("cleanup left bucket %s behind: %s", bucket.Name(), scrub(err.Error()))
		}
	}
}

func emptyBucket(ctx context.Context, bucket *b2.Bucket) {
	iter := bucket.List(ctx, b2.ListHidden())
	for iter.Next() {
		iter.Object().Delete(ctx)
	}
	unfinished := bucket.List(ctx, b2.ListUnfinished())
	for unfinished.Next() {
		unfinished.Object().Cancel(ctx)
	}
}

// upload writes payload to name. tune runs before the first Write, because
// blazer requires Writer fields to be set before then.
func upload(ctx context.Context, bucket *b2.Bucket, name string, payload []byte, attrs *b2.Attrs, tune func(*b2.Writer)) (*b2.Object, error) {
	object := bucket.Object(name)
	var opts []b2.WriterOption
	if attrs != nil {
		opts = append(opts, b2.WithAttrsOption(attrs))
	}
	writer := object.NewWriter(ctx, opts...)
	if tune != nil {
		tune(writer)
	}
	if _, err := writer.Write(payload); err != nil {
		writer.Close()
		return nil, classify("upload", err)
	}
	if err := writer.Close(); err != nil {
		return nil, classify("upload", err)
	}
	return object, nil
}

func download(ctx context.Context, bucket *b2.Bucket, name string, tune func(*b2.Reader)) ([]byte, error) {
	reader := bucket.Object(name).NewReader(ctx)
	if tune != nil {
		tune(reader)
	}
	data, readErr := io.ReadAll(reader)
	closeErr := reader.Close()
	if readErr != nil {
		return nil, classify("download", readErr)
	}
	if closeErr != nil {
		return nil, classify("download", closeErr)
	}
	return data, nil
}

// versionsOf returns every listed version of name, newest first.
func versionsOf(ctx context.Context, bucket *b2.Bucket, name string) ([]*b2.Object, error) {
	var found []*b2.Object
	iter := bucket.List(ctx, b2.ListPrefix(name), b2.ListHidden())
	for iter.Next() {
		if iter.Object().Name() == name {
			found = append(found, iter.Object())
		}
	}
	if err := iter.Err(); err != nil {
		return nil, classify("list versions", err)
	}
	return found, nil
}

func namesUnder(ctx context.Context, bucket *b2.Bucket, prefix string) ([]string, error) {
	var names []string
	iter := bucket.List(ctx, b2.ListPrefix(prefix))
	for iter.Next() {
		names = append(names, iter.Object().Name())
	}
	if err := iter.Err(); err != nil {
		return nil, classify("list", err)
	}
	return names, nil
}

// rpcCounts sums blazer's per-method RPC counters across every window it
// reports (b2/monitor.go, surfaced by Client.Status). The windows overlap, so
// the absolute numbers mean nothing; "was this method called between two
// reads" -- which is what the boundary assertions use -- is sound.
func rpcCounts(client *b2.Client) map[string]int {
	counts := map[string]int{}
	info := client.Status()
	if info == nil {
		return counts
	}
	for _, methods := range info.RPCs {
		for name, n := range methods.CountByMethod() {
			counts[name] += n
		}
	}
	return counts
}

func rpcDelta(before, after map[string]int) []string {
	var moved []string
	for name, n := range after {
		if n > before[name] {
			moved = append(moved, name)
		}
	}
	sort.Strings(moved)
	return moved
}

func anyContains(values []string, substr string) bool {
	for _, value := range values {
		if strings.Contains(strings.ToLower(value), substr) {
			return true
		}
	}
	return false
}

// exportedFields names a struct's exported fields, which is how the ⚠ boundary
// assertions interrogate the PUBLISHED package rather than trusting the card.
func exportedFields(v interface{}) []string {
	var names []string
	t := reflect.TypeOf(v)
	for t.Kind() == reflect.Ptr {
		t = t.Elem()
	}
	if t.Kind() != reflect.Struct {
		return names
	}
	for i := 0; i < t.NumField(); i++ {
		if field := t.Field(i); field.PkgPath == "" {
			names = append(names, field.Name)
		}
	}
	sort.Strings(names)
	return names
}

func infoValue(info map[string]string, key string) (string, bool) {
	for k, v := range info {
		if strings.EqualFold(k, key) {
			return v, true
		}
	}
	return "", false
}

func main() {
	target := requestedTarget()
	defer func() {
		if r := recover(); r != nil {
			say(target, fmt.Sprintf("FAIL (panic -- %s)", scrub(fmt.Sprint(r))))
			os.Exit(1)
		}
	}()
	err := runCheck(context.Background(), &target)
	switch e := err.(type) {
	case nil:
		say(target, "PASS")
	case *amberErr:
		say(target, fmt.Sprintf("COULD-NOT-RUN (%s -- %s)", e.reason, e.detail))
	case *failErr:
		say(target, fmt.Sprintf("FAIL (%s -- %s)", e.step, e.detail))
		os.Exit(1)
	default:
		say(target, fmt.Sprintf("FAIL (check -- %s)", scrub(err.Error())))
		os.Exit(1)
	}
}
