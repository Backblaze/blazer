#!/usr/bin/env bash
# CONFORMANCE blazer x lock.per_file -- low-level FileLock argument validation.
#
# Oracle: docs/object-lock.md, "Low-level arguments and migration", and the
# v0.10.0 release notes (.changes/v0.10.0.md, Changed): each upload/start method
# accepts at most one base.FileLock; retention and legal hold share that value.
# https://github.com/Backblaze/blazer/blob/v0.10.0/docs/object-lock.md
# https://github.com/Backblaze/blazer/blob/v0.10.0/.changes/v0.10.0.md
#
# Uses serve.mjs at CONFORMANCE_SIMULATOR_URL. This checks configuration and
# local validation, not delete enforcement under hold. Retention/hold updates
# already have lock.per_file_retention and lock.legal_hold scenarios.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd -P)"
SLUG=blazer
CAP=lock.per_file
TARGET=simulator
say() { printf 'CONFORMANCE %s %s @%s: %s\n' "$SLUG" "$CAP" "$1" "$2"; }
tidy_detail() { printf '%s' "$1" | tr '\n\r\t' '   ' | tr -cd '[:print:]' | cut -c1-200; }

. "$(dirname "$0")/../lib/contract.sh"
if ! sdkharness_leaf_guard CONFORMANCE_TARGET CONFORMANCE_SIMULATOR_URL; then
  say simulator "FAIL ($SDKHARNESS_GUARD_REASON)"
  exit 1
fi
sdkharness_go_offline_env
if ! command -v go >/dev/null 2>&1; then
  say "$TARGET" "COULD-NOT-RUN (missing-runtime -- no Go toolchain on PATH)"
  exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-conf-blazer.XXXXXX")" || {
  say "$TARGET" "FAIL (setup -- could not create a scratch directory)"
  exit 1
}
trap 'rm -rf "$work"' EXIT HUP INT TERM
awk '/^__EOF_GO__$/ { inprog = 0 } inprog { print } /^: <</ { inprog = 1 }' "$0" > "$work/main.go"
cat > "$work/go.mod" <<EOF
module sdkharness-conformance-blazer

go 1.26.10

require github.com/Backblaze/blazer v0.10.0

replace github.com/Backblaze/blazer => $REPO_ROOT
EOF
cp "$(dirname "$0")/../lib/loopback_guard.go.txt" "$work/loopback_guard.go"
sdkharness_go_build "$work" check
case "$?" in
  0) ;;
  10) say "$TARGET" "COULD-NOT-RUN (missing-runtime -- $SDKHARNESS_BUILD_REASON)"; exit 0 ;;
  *) say "$TARGET" "FAIL (build -- blazer or this check did not compile offline: $(tidy_detail "$SDKHARNESS_BUILD_OUT"))"; exit 1 ;;
esac

run_out="$("$work/check" 2>&1)"
run_rc=$?
printf '%s\n' "$run_out" | grep -E '^NOTE ' || true
line="$(printf '%s\n' "$run_out" | grep -E "^CONFORMANCE $SLUG $CAP @" | tail -1)"
if [ -z "$line" ]; then
  say "$TARGET" "FAIL (harness -- the check binary produced no result line: $(tidy_detail "$run_out"))"
  exit 1
fi
printf '%s\n' "$line"
exit "$run_rc"

: <<'__EOF_GO__'
package main

import (
	"context"
	"crypto/rand"
	"errors"
	"fmt"
	"net/http"
	"os"
	"reflect"
	"strings"
	"sync/atomic"
	"time"

	"github.com/Backblaze/blazer/base"
)

// Forward every request to serve.mjs, counting calls at the real HTTP boundary.
type countingTransport struct {
	next  http.RoundTripper
	calls atomic.Int64
}

func (t *countingTransport) RoundTrip(req *http.Request) (*http.Response, error) {
	t.calls.Add(1)
	return t.next.RoundTrip(req)
}

func runCheck(ctx context.Context) (result error) {
	wire := &countingTransport{next: http.DefaultTransport}
	account, err := base.AuthorizeAccount(ctx, "test-key-id", "test-key",
		base.SetAPIBase(strings.TrimSuffix(os.Getenv("CONFORMANCE_SIMULATOR_URL"), "/")), base.Transport(wire))
	if err != nil {
		return fmt.Errorf("authorize: %w", err)
	}
	var suffix [6]byte
	if _, err := rand.Read(suffix[:]); err != nil {
		return err
	}
	bucket, err := account.CreateBucket(ctx, fmt.Sprintf("sdkharness-lock-%x", suffix), "allPrivate", nil, nil, nil, nil, true, nil)
	if err != nil {
		return fmt.Errorf("create lock-enabled bucket: %w", err)
	}
	var uploads []*base.File
	var starts []*base.LargeFile
	defer func() {
		cleanupCtx, cancel := context.WithTimeout(context.Background(), 15*time.Second)
		defer cancel()
		for _, large := range starts {
			result = errors.Join(result, large.CancelLargeFile(cleanupCtx))
		}
		for _, file := range uploads {
			result = errors.Join(result, file.UpdateFileLegalHold(cleanupCtx, "off"))
			result = errors.Join(result, file.UpdateFileRetention(cleanupCtx, nil, true))
			result = errors.Join(result, file.DeleteFileVersion(cleanupCtx, true))
		}
		result = errors.Join(result, bucket.DeleteBucket(cleanupCtx))
	}()
	uploadURL, err := bucket.GetUploadURL(ctx)
	if err != nil {
		return fmt.Errorf("get upload URL: %w", err)
	}
	retention := &base.FileRetention{Mode: "governance", RetainUntilTimestamp: time.Now().Add(time.Hour).UnixMilli()}
	cases := []struct {
		name    string
		locks   []base.FileLock
		wantErr string
	}{
		{name: "zero"},
		{name: "one-empty", locks: []base.FileLock{{}}},
		{name: "one-combined", locks: []base.FileLock{{Retention: retention, LegalHold: "on"}}},
		{name: "two", locks: []base.FileLock{{Retention: retention}, {LegalHold: "on"}}, wantErr: "b2: at most one FileLock may be given, got 2"},
		{name: "three", locks: []base.FileLock{{Retention: retention}, {LegalHold: "on"}, {}}, wantErr: "b2: at most one FileLock may be given, got 3"},
	}
	var failures []string
	for _, method := range []string{"UploadFile", "UploadFileWithSSEC", "StartLargeFile", "StartLargeFileWithSSEC"} {
		for _, tc := range cases {
			name := "st/" + method + "/" + tc.name
			var file *base.File
			var large *base.LargeFile
			before := wire.calls.Load()
			// Encryption is nil: these cases pin FileLock validation through
			// the WithSSEC entry points, not SSE-C encryption semantics.
			switch method {
			case "UploadFile":
				file, err = uploadURL.UploadFile(ctx, strings.NewReader("x"), 1, name, "text/plain", "11f6ad8ec52a2984abaafd7c3b516503785c2072", nil, tc.locks...)
			case "UploadFileWithSSEC":
				file, err = uploadURL.UploadFileWithSSEC(ctx, strings.NewReader("x"), 1, name, "text/plain", "11f6ad8ec52a2984abaafd7c3b516503785c2072", nil, nil, tc.locks...)
			case "StartLargeFile":
				large, err = bucket.StartLargeFile(ctx, name, "text/plain", nil, tc.locks...)
			case "StartLargeFileWithSSEC":
				large, err = bucket.StartLargeFileWithSSEC(ctx, name, "text/plain", nil, nil, tc.locks...)
			}
			calls := wire.calls.Load() - before
			// Track unexpected successes too, so a broken guard cannot leak resources.
			if file != nil {
				uploads = append(uploads, file)
			}
			if large != nil {
				starts = append(starts, large)
			}
			if tc.wantErr != "" {
				if err == nil || err.Error() != tc.wantErr || calls != 0 || file != nil || large != nil {
					failures = append(failures, fmt.Sprintf("%s/%s: error=%v requests=%d resource=%t; want %q, 0, false", method, tc.name, err, calls, file != nil || large != nil, tc.wantErr))
				}
				continue
			}
			if err != nil || calls != 1 || file == nil && large == nil {
				failures = append(failures, fmt.Sprintf("%s/%s: error=%v requests=%d; want success and 1 request", method, tc.name, err, calls))
				continue
			}
			var info *base.FileInfo
			if file != nil {
				info, err = file.GetFileInfo(ctx)
			} else {
				var unfinished []*base.File
				unfinished, _, err = bucket.ListUnfinishedLargeFiles(ctx, 100, "")
				for _, candidate := range unfinished {
					if candidate.ID == large.ID {
						info = candidate.Info
					}
				}
			}
			if err != nil || info == nil {
				failures = append(failures, fmt.Sprintf("%s/%s: missing file metadata, error=%v", method, tc.name, err))
				continue
			}
			if tc.name == "one-combined" {
				if !reflect.DeepEqual(info.Retention, retention) || info.LegalHold != "on" {
					failures = append(failures, fmt.Sprintf("%s/%s: want governance retention at %d and legalHold=on", method, tc.name, retention.RetainUntilTimestamp))
				}
			} else if info.Retention != nil || info.LegalHold != "" && info.LegalHold != "off" {
				failures = append(failures, fmt.Sprintf("%s/%s: zero/empty FileLock unexpectedly set a lock", method, tc.name))
			}
		}
	}
	if len(failures) != 0 {
		return fmt.Errorf("%s", strings.Join(failures, "; "))
	}
	fmt.Println("NOTE blazer lock.per_file: methods=4 cases=20 zero/one=accepted extra-locks=rejected-before-request combined=retention+hold read-back")
	return nil
}

func main() {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	if err := runCheck(ctx); err != nil {
		detail := strings.Join(strings.Fields(err.Error()), " ")
		fmt.Printf("CONFORMANCE blazer lock.per_file @simulator: FAIL (FileLock -- %s)\n", detail)
		os.Exit(1)
	}
	fmt.Println("CONFORMANCE blazer lock.per_file @simulator: PASS")
}
__EOF_GO__
