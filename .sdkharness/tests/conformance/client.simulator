#!/usr/bin/env bash
# CONFORMANCE blazer x client.simulator -- a downstream client uses the shipped
# in-process B2 wire server, not the harness simulator or real network.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd -P)"
SLUG=blazer
CAP=client.simulator
TARGET=simulator

say() { printf 'CONFORMANCE %s %s @%s: %s\n' "$SLUG" "$CAP" "$1" "$2"; }
tidy_detail() { printf '%s' "$1" | tr '\n\r\t' '   ' | tr -cd '[:print:]' | cut -c1-200; }

. "$(dirname "$0")/../lib/contract.sh"
if ! sdkharness_leaf_guard CONFORMANCE_TARGET CONFORMANCE_SIMULATOR_URL; then
  say simulator "FAIL ($SDKHARNESS_GUARD_REASON)"
  exit 1
fi
sdkharness_go_offline_env
if ! command -v go >/dev/null 2>&1; then
  say "$TARGET" "COULD-NOT-RUN (missing-runtime -- no Go toolchain on PATH)"
  exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-conf-blazer.XXXXXX")" || {
  say "$TARGET" "FAIL (setup -- could not create a scratch directory)"
  exit 1
}
trap 'rm -rf "$work"' EXIT HUP INT TERM

awk '/^__EOF_GO__$/ { inprog = 0 } inprog { print } /^: <</ { inprog = 1 }' "$0" > "$work/main.go"
cat > "$work/go.mod" <<EOF
module sdkharness-conformance-blazer

go 1.18

require github.com/Backblaze/blazer v0.8.0

replace github.com/Backblaze/blazer => $REPO_ROOT
EOF
cp "$(dirname "$0")/../lib/loopback_guard.go.txt" "$work/loopback_guard.go"
sdkharness_go_build "$work" check
case "$?" in
  0) ;;
  10) say "$TARGET" "COULD-NOT-RUN (missing-runtime -- $SDKHARNESS_BUILD_REASON)"; exit 0 ;;
  *) say "$TARGET" "FAIL (build -- blazer or this check did not compile offline: $(tidy_detail "$SDKHARNESS_BUILD_OUT"))"; exit 1 ;;
esac

run_out="$("$work/check" 2>&1)"
run_rc=$?
printf '%s\n' "$run_out" | grep -E '^NOTE ' || true
line="$(printf '%s\n' "$run_out" | grep -E "^CONFORMANCE $SLUG $CAP @" | tail -1)"
if [ -z "$line" ]; then
  say "$TARGET" "FAIL (harness -- the check binary produced no result line: $(tidy_detail "$run_out"))"
  exit 1
fi
printf '%s\n' "$line"
exit "$run_rc"

: <<'__EOF_GO__'
package main

import (
	"bytes"
	"context"
	"fmt"
	"io"
	"os"

	"github.com/Backblaze/blazer/b2"
	"github.com/Backblaze/blazer/x/b2sim"
)

func check() error {
	ctx := context.Background()
	sim := b2sim.New()
	client, err := b2.NewClient(ctx, "offline-id", "offline-key", b2.Transport(sim))
	if err != nil { return fmt.Errorf("authorize: %w", err) }
	bucket, err := client.NewBucket(ctx, "offline-golden", nil)
	if err != nil { return fmt.Errorf("create bucket: %w", err) }
	objects := []struct{name string; data []byte; chunk int}{
		{"simple.txt", []byte("offline simple object"), 0},
		{"large.txt", bytes.Repeat([]byte("large"), 2_100_001), 5_000_000},
	}
	for _, item := range objects {
		obj := bucket.Object(item.name)
		w := obj.NewWriter(ctx)
		if item.chunk != 0 { w.ChunkSize = item.chunk; w.ConcurrentUploads = 2 }
		if n, err := w.Write(item.data); err != nil || n != len(item.data) { return fmt.Errorf("write %s: n=%d err=%v", item.name, n, err) }
		if err := w.Close(); err != nil { return fmt.Errorf("close %s: %w", item.name, err) }
		r := obj.NewReader(ctx)
		got, readErr := io.ReadAll(r)
		closeErr := r.Close()
		if readErr != nil || closeErr != nil || !bytes.Equal(got, item.data) { return fmt.Errorf("download %s: read=%v close=%v match=%t", item.name, readErr, closeErr, bytes.Equal(got, item.data)) }
		if item.name == "simple.txt" {
			rangeReader := obj.NewRangeReader(ctx, 3, 5)
			part, readErr := io.ReadAll(rangeReader)
			closeErr := rangeReader.Close()
			if readErr != nil || closeErr != nil || !bytes.Equal(part, item.data[3:8]) { return fmt.Errorf("range: read=%v close=%v match=%t", readErr, closeErr, bytes.Equal(part, item.data[3:8])) }
		}
	}
	calls := sim.Calls()
	if calls["b2_start_large_file"] != 1 || calls["b2_upload_part"] < 2 || calls["b2_finish_large_file"] != 1 { return fmt.Errorf("multipart wire calls missing: %v", calls) }
	iter := bucket.List(ctx)
	count := 0
	for iter.Next() { count++ }
	if err := iter.Err(); err != nil || count != 2 { return fmt.Errorf("list: count=%d err=%v", count, err) }
	for _, item := range objects { if err := bucket.Object(item.name).Delete(ctx); err != nil { return fmt.Errorf("delete %s: %w", item.name, err) } }
	if err := bucket.Delete(ctx); err != nil { return fmt.Errorf("delete bucket: %w", err) }
	if len(sim.Buckets()) != 0 { return fmt.Errorf("bucket remained after deletion") }
	return nil
}

func main() {
	if err := check(); err != nil {
		fmt.Printf("CONFORMANCE blazer client.simulator @simulator: FAIL (%v)\n", err)
		os.Exit(1)
	}
	fmt.Println("NOTE blazer client.simulator: public Transport injected an in-process B2 wire simulator; no network was used")
	fmt.Println("CONFORMANCE blazer client.simulator @simulator: PASS")
}
__EOF_GO__
