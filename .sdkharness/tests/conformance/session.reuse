#!/usr/bin/env bash
# CONFORMANCE blazer x session.reuse -- an explicit AccountInfo store carries
# one authorized session across two client operations without reauthorization.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd -P)"
SLUG=blazer
CAP=session.reuse
TARGET=simulator

say() { printf 'CONFORMANCE %s %s @%s: %s\n' "$SLUG" "$CAP" "$1" "$2"; }
tidy_detail() { printf '%s' "$1" | tr '\n\r\t' '   ' | tr -cd '[:print:]' | cut -c1-200; }

. "$(dirname "$0")/../lib/contract.sh"
if ! sdkharness_leaf_guard CONFORMANCE_TARGET CONFORMANCE_SIMULATOR_URL; then
	say simulator "FAIL ($SDKHARNESS_GUARD_REASON)"
	exit 1
fi
sdkharness_go_offline_env
if ! command -v go >/dev/null 2>&1; then
	say "$TARGET" "COULD-NOT-RUN (missing-runtime -- no Go toolchain on PATH)"
	exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-conf-blazer.XXXXXX")" || {
	say "$TARGET" "FAIL (setup -- could not create a scratch directory)"
	exit 1
}
trap 'rm -rf "$work"' EXIT HUP INT TERM

awk '/^__EOF_GO__$/ { inprog = 0 } inprog { print } /^: <</ { inprog = 1 }' "$0" > "$work/main.go"
cat > "$work/go.mod" <<EOF
module sdkharness-conformance-blazer

go 1.18

require github.com/Backblaze/blazer v0.10.0

replace github.com/Backblaze/blazer => $REPO_ROOT
EOF
cp "$(dirname "$0")/../lib/loopback_guard.go.txt" "$work/loopback_guard.go"
sdkharness_go_build "$work" check
case "$?" in
	0) ;;
	10) say "$TARGET" "COULD-NOT-RUN (missing-runtime -- $SDKHARNESS_BUILD_REASON)"; exit 0 ;;
	*) say "$TARGET" "FAIL (build -- blazer or this check did not compile offline: $(tidy_detail "$SDKHARNESS_BUILD_OUT"))"; exit 1 ;;
esac

run_out="$("$work/check" 2>&1)"
run_rc=$?
printf '%s\n' "$run_out" | grep -E '^NOTE ' || true
line="$(printf '%s\n' "$run_out" | grep -E "^CONFORMANCE $SLUG $CAP @" | tail -1)"
if [ -z "$line" ]; then
	say "$TARGET" "FAIL (harness -- the check binary produced no result line: $(tidy_detail "$run_out"))"
	exit 1
fi
printf '%s\n' "$line"
exit "$run_rc"

: <<'__EOF_GO__'
package main

import (
	"context"
	"fmt"
	"os"

	"github.com/Backblaze/blazer/b2"
	"github.com/Backblaze/blazer/x/b2sim"
)

func runCheck(ctx context.Context) error {
	sim := b2sim.New()
	store := &b2.InMemoryAccountInfo{}

	first, err := b2.NewClient(ctx, "offline-id", "offline-key", b2.Transport(sim), b2.WithAccountInfo(store))
	if err != nil {
		return fmt.Errorf("first authorize: %w", err)
	}
	if _, err := first.ListBuckets(ctx); err != nil {
		return fmt.Errorf("first operation: %w", err)
	}

	second, err := b2.NewClient(ctx, "offline-id", "offline-key", b2.Transport(sim), b2.WithAccountInfo(store))
	if err != nil {
		return fmt.Errorf("reuse cached session: %w", err)
	}
	if _, err := second.ListBuckets(ctx); err != nil {
		return fmt.Errorf("second operation: %w", err)
	}

	calls := sim.Calls()
	if calls["b2_authorize_account"] != 1 {
		return fmt.Errorf("b2_authorize_account calls = %d, want 1 across both operations", calls["b2_authorize_account"])
	}
	if calls["b2_list_buckets"] != 2 {
		return fmt.Errorf("b2_list_buckets calls = %d, want 2", calls["b2_list_buckets"])
	}
	return nil
}

func main() {
	if err := runCheck(context.Background()); err != nil {
		fmt.Printf("CONFORMANCE blazer session.reuse @simulator: FAIL (session -- %v)\n", err)
		os.Exit(1)
	}
	fmt.Println("NOTE blazer session.reuse: two clients share an explicit AccountInfo store through WithAccountInfo")
	fmt.Println("CONFORMANCE blazer session.reuse @simulator: PASS")
}
__EOF_GO__
