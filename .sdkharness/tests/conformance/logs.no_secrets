#!/usr/bin/env bash
# CONFORMANCE blazer x logs.no_secrets -- exercise the real SDK logger offline.
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd -P)"
SLUG=blazer
CAP=logs.no_secrets
TARGET=simulator

say() { printf 'CONFORMANCE %s %s @%s: %s\n' "$SLUG" "$CAP" "$1" "$2"; }
tidy_detail() { printf '%s' "$1" | tr '\n\r\t' '   ' | tr -cd '[:print:]' | cut -c1-200; }

. "$(dirname "$0")/../lib/contract.sh"
if ! sdkharness_leaf_guard CONFORMANCE_TARGET CONFORMANCE_SIMULATOR_URL; then
  say simulator "FAIL ($SDKHARNESS_GUARD_REASON)"
  exit 1
fi
sdkharness_go_offline_env
if ! command -v go >/dev/null 2>&1; then
  say "$TARGET" "COULD-NOT-RUN (missing-runtime -- no Go toolchain on PATH)"
  exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-conf-blazer.XXXXXX")" || {
  say "$TARGET" "FAIL (setup -- could not create a scratch directory)"
  exit 1
}
trap 'rm -rf "$work"' EXIT HUP INT TERM

awk '/^__EOF_GO__$/ { inprog = 0 } inprog { print } /^: <</ { inprog = 1 }' "$0" > "$work/main.go"
# The module prefix permits the focused CR/LF canary to call the same private
# logger as base, without copying its sanitizer into this assertion.
cat > "$work/go.mod" <<EOF
module github.com/Backblaze/blazer/sdkharness-conformance-logs

go 1.26.10

require github.com/Backblaze/blazer v0.10.0

replace github.com/Backblaze/blazer => $REPO_ROOT
EOF
cp "$(dirname "$0")/../lib/loopback_guard.go.txt" "$work/loopback_guard.go"
sdkharness_go_build "$work" check
case "$?" in
  0) ;;
  10) say "$TARGET" "COULD-NOT-RUN (missing-runtime -- $SDKHARNESS_BUILD_REASON)"; exit 0 ;;
  *) say "$TARGET" "FAIL (build -- blazer or this check did not compile offline: $(tidy_detail "$SDKHARNESS_BUILD_OUT"))"; exit 1 ;;
esac

# blog reads its verbosity once during package initialization. The leaf guard
# removes ambient B2_* variables first, so set it explicitly on the child.
run_out="$(B2_LOG_LEVEL=2 "$work/check" 2>&1)"
run_rc=$?
printf '%s\n' "$run_out" | grep -E '^NOTE ' || true
line="$(printf '%s\n' "$run_out" | grep -E "^CONFORMANCE $SLUG $CAP @" | tail -1)"
if [ -z "$line" ]; then
  # Never echo the captured log, even if the check crashes or finds a leak.
  say "$TARGET" "FAIL (harness -- the check binary produced no result line)"
  exit 1
fi
printf '%s\n' "$line"
exit "$run_rc"

: <<'__EOF_GO__'
package main

import (
	"bytes"
	"context"
	"crypto/md5"
	"encoding/base64"
	"encoding/hex"
	"encoding/json"
	"fmt"
	"io"
	"log"
	"net/http"
	"os"
	"strings"
	"time"

	"github.com/Backblaze/blazer/b2"
	"github.com/Backblaze/blazer/internal/blog"
	"github.com/Backblaze/blazer/x/b2sim"
)

const applicationSecret = "logs-fixture-application-secret-385"
const signingSecret = "0123456789abcdef0123456789abcdef"

// x/b2sim does not implement key or notification endpoints. These fixtures
// supply only those replies; blazer still builds, logs and decodes the wire
// messages. All other requests go to the shipped simulator, never the network.
// https://www.backblaze.com/apidocs/b2-create-key
// https://www.backblaze.com/apidocs/b2-set-bucket-notification-rules
type fixtureTransport struct {
	sim                  *b2sim.Simulator
	created, deleted     int
	configured, cleared  int
	ssecUploads          int
	encodedKey, keyMD5   string
}

func reply(req *http.Request, value any) (*http.Response, error) {
	data, err := json.Marshal(value)
	if err != nil {
		return nil, err
	}
	return &http.Response{
		StatusCode: http.StatusOK, Request: req,
		Header: http.Header{"Content-Type": {"application/json"}},
		Body: io.NopCloser(bytes.NewReader(data)), ContentLength: int64(len(data)),
	}, nil
}

func (t *fixtureTransport) RoundTrip(req *http.Request) (*http.Response, error) {
	switch req.Header.Get("X-Blazer-Method") {
	case "b2_create_key":
		t.created++
		defer req.Body.Close()
		var args struct { KeyName string `json:"keyName"` }
		if err := json.NewDecoder(req.Body).Decode(&args); err != nil || args.KeyName != "logs-no-secrets-key" {
			return nil, fmt.Errorf("unexpected create-key request")
		}
		return reply(req, map[string]any{
			"accountId": "b2sim-account", "applicationKeyId": "logs-key-id",
			"applicationKey": applicationSecret, "keyName": args.KeyName,
			"capabilities": []string{"readFiles"}, "expirationTimestamp": nil,
		})
	case "b2_delete_key":
		t.deleted++
		defer req.Body.Close()
		return reply(req, map[string]any{"applicationKeyId": "logs-key-id"})
	case "b2_set_bucket_notification_rules":
		defer req.Body.Close()
		var args struct {
			BucketID string `json:"bucketId"`
			Rules []struct {
				Target struct { Secret string `json:"hmacSha256SigningSecret"` } `json:"targetConfiguration"`
			} `json:"eventNotificationRules"`
		}
		if err := json.NewDecoder(req.Body).Decode(&args); err != nil || args.BucketID == "" {
			return nil, fmt.Errorf("unexpected notification request")
		}
		if len(args.Rules) == 0 {
			t.cleared++
			return reply(req, map[string]any{"bucketId": args.BucketID, "eventNotificationRules": []any{}})
		}
		if len(args.Rules) != 1 || args.Rules[0].Target.Secret != signingSecret {
			return nil, fmt.Errorf("notification signing fixture was not sent")
		}
		t.configured++
		return reply(req, map[string]any{
			"bucketId": args.BucketID, "eventNotificationRules": []any{map[string]any{
				"name": "logs-rule", "isEnabled": true,
				"eventTypes": []string{"b2:ObjectCreated:Upload"},
				"targetConfiguration": map[string]any{
					"targetType": "webhook", "url": "https://example.invalid/notify",
					"hmacSha256SigningSecret": signingSecret,
				},
			}},
		})
	case "b2_upload_file":
		if req.Header.Get("X-Bz-Server-Side-Encryption-Customer-Key") != t.encodedKey ||
			req.Header.Get("X-Bz-Server-Side-Encryption-Customer-Key-Md5") != t.keyMD5 {
			return nil, fmt.Errorf("SSE-C key fixture was not sent")
		}
		t.ssecUploads++
	}
	return t.sim.RoundTrip(req)
}

func check() error {
	ctx, cancel := context.WithTimeout(context.Background(), 30*time.Second)
	defer cancel()
	var captured bytes.Buffer
	previousOutput, previousFlags := log.Writer(), log.Flags()
	log.SetOutput(&captured)
	log.SetFlags(0)
	defer func() { log.SetOutput(previousOutput); log.SetFlags(previousFlags) }()
	if !blog.V(2) {
		return fmt.Errorf("debug logging is not enabled")
	}
	material := bytes.Repeat([]byte{0x33}, 32)
	key, err := b2.NewSSECKey(material)
	if err != nil { return fmt.Errorf("construct SSE-C key") }
	digest := md5.Sum(material)
	transport := &fixtureTransport{
		sim: b2sim.New(), encodedKey: base64.StdEncoding.EncodeToString(material),
		keyMD5: base64.StdEncoding.EncodeToString(digest[:]),
	}
	store := &b2.InMemoryAccountInfo{}
	client, err := b2.NewClient(ctx, "test-key-id", "test-key", b2.Transport(transport), b2.WithAccountInfo(store))
	if err != nil { return fmt.Errorf("authorize") }
	auth, ok := store.AuthData()
	if !ok || auth.AuthToken == "" { return fmt.Errorf("authorization token was not obtained") }
	created, err := client.CreateKey(ctx, "logs-no-secrets-key", b2.Capabilities("readFiles"))
	if err != nil { return fmt.Errorf("create key") }
	if created.Secret() != applicationSecret { return fmt.Errorf("created key fixture was not decoded") }
	bucket, err := client.NewBucket(ctx, "logs-no-secrets", nil)
	if err != nil { return fmt.Errorf("create bucket") }
	object := bucket.Object("logs-upload.txt")
	writer := object.NewWriter(ctx, b2.WithSSECKey(key))
	if _, err := writer.Write([]byte("logs-no-secrets-payload")); err != nil {
		_ = writer.Close()
		return fmt.Errorf("write SSE-C upload")
	}
	if err := writer.Close(); err != nil { return fmt.Errorf("close SSE-C upload") }
	if err := bucket.SetNotificationRules(ctx, []b2.NotificationRule{{
		Name: "logs-rule", IsEnabled: true, EventTypes: []string{"b2:ObjectCreated:Upload"},
		TargetConfiguration: b2.NotificationTargetConfiguration{
			TargetType: b2.NotificationTargetWebhook,
			Webhook: &b2.WebhookNotificationTarget{URL: "https://example.invalid/notify", HMACSHA256SigningSecret: signingSecret},
		},
	}}); err != nil { return fmt.Errorf("set notification rules") }

	// Both public logging entry points must emit exactly one physical line.
	start := captured.Len()
	blog.V(2).Info("CRLF canary: ", "before\r\nFORGED-LOG-LINE\rafter\nend")
	blog.V(2).Infof("CRLF formatted canary: %s", "before\r\nFORGED-LOG-LINE\rafter\nend")
	if captured.String()[start:] != "CRLF canary: beforeFORGED-LOG-LINEafterend\nCRLF formatted canary: beforeFORGED-LOG-LINEafterend\n" {
		return fmt.Errorf("CR/LF value forged or changed a log line")
	}
	if err := bucket.SetNotificationRules(ctx, nil); err != nil { return fmt.Errorf("clear notification fixture") }
	if err := object.Delete(ctx); err != nil { return fmt.Errorf("delete object") }
	if err := bucket.Delete(ctx); err != nil { return fmt.Errorf("delete bucket") }
	if err := created.Delete(ctx); err != nil { return fmt.Errorf("delete key fixture") }
	calls := transport.sim.Calls()
	if calls["b2_authorize_account"] != 1 || calls["b2_upload_file"] != 1 || transport.ssecUploads != 1 ||
		transport.created != 1 || transport.deleted != 1 || transport.configured != 1 || transport.cleared != 1 || len(transport.sim.Buckets()) != 0 {
		return fmt.Errorf("operations or cleanup did not execute exactly once")
	}
	logs := captured.String()
	for _, method := range []string{"b2_authorize_account", "b2_create_key", "b2_upload_file", "b2_set_bucket_notification_rules"} {
		if !strings.Contains(logs, ">> "+method+" ") || !strings.Contains(logs, "<< "+method+" ") {
			return fmt.Errorf("missing request or response debug log for %s", method)
		}
	}
	if !strings.Contains(logs, "logs-no-secrets-key") || !strings.Contains(logs, "logs-rule") || !strings.Contains(logs, "[redacted]") {
		return fmt.Errorf("non-secret wire fields or redaction marker missing")
	}
	for _, secret := range []struct{ name, value string }{
		{"authorization token", auth.AuthToken}, {"application key secret", created.Secret()},
		{"raw SSE-C key", string(material)}, {"base64 SSE-C key", transport.encodedKey},
		{"hex SSE-C key", hex.EncodeToString(material)}, {"SSE-C key MD5", transport.keyMD5},
		{"notification signing secret", signingSecret},
	} {
		if secret.value == "" || strings.Contains(logs, secret.value) {
			return fmt.Errorf("secret-log assertion failed: %s", secret.name)
		}
	}
	return nil
}

func main() {
	if err := check(); err != nil {
		// Errors name only the failed step or secret category, never its value
		// or the captured wire log. A failing check is safe to publish as evidence.
		fmt.Printf("CONFORMANCE blazer logs.no_secrets @simulator: FAIL (%v)\n", err)
		os.Exit(1)
	}
	fmt.Println("NOTE blazer logs.no_secrets: debug request/response logs checked for four credential categories and CR/LF injection; in-process simulator with key/notification fixtures; no network")
	fmt.Println("CONFORMANCE blazer logs.no_secrets @simulator: PASS")
}
__EOF_GO__
