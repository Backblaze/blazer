#!/usr/bin/env bash
# RESILIENCE blazer x download.range_validation -- malformed range responses
# injected by a controllable Transport; no simulator state or faults are changed.
#
# Oracle: v0.10.0's breaking-change notes for #179 require
# base.ErrInvalidRangeResponse for HTTP 200 at a nonzero offset, overlong
# HTTP 200/206 responses, chunked responses without Content-Length, and
# missing or invalid Content-Range on HTTP 206. A well-formed 206 must succeed.
# https://github.com/Backblaze/blazer/releases/tag/v0.10.0
# https://github.com/Backblaze/blazer/issues/179
set -uo pipefail

REPO_ROOT="$(cd "$(dirname "$0")/../../.." && pwd -P)"
say() { printf 'RESILIENCE blazer download.range_validation @simulator: %s\n' "$1"; }
tidy_detail() { printf '%s' "$1" | tr '\n\r\t' '   ' | tr -cd '[:print:]' | cut -c1-200; }

. "$(dirname "$0")/../lib/contract.sh"
if ! sdkharness_leaf_guard RESILIENCE_TARGET RESILIENCE_SIMULATOR_URL RESILIENCE_CONTROL_URL; then
  say "FAIL ($SDKHARNESS_GUARD_REASON)"
  exit 1
fi
sdkharness_go_offline_env
if ! command -v go >/dev/null 2>&1; then
  say "COULD-NOT-RUN (missing-runtime -- no Go toolchain on PATH)"
  exit 0
fi

work="$(mktemp -d "${TMPDIR:-/tmp}/sdkharness-res-blazer.XXXXXX")" || {
  say "FAIL (setup -- could not create a scratch directory)"
  exit 1
}
trap 'rm -rf "$work"' EXIT HUP INT TERM
awk '/^__EOF_GO__$/ { inprog = 0 } inprog { print } /^: <</ { inprog = 1 }' "$0" > "$work/main.go"
cat > "$work/go.mod" <<MOD
module sdkharness-resilience-blazer

go 1.18

require github.com/Backblaze/blazer v0.10.0

replace github.com/Backblaze/blazer => $REPO_ROOT
MOD
cp "$(dirname "$0")/../lib/loopback_guard.go.txt" "$work/loopback_guard.go"
sdkharness_go_build "$work" check
case "$?" in
  0) ;;
  10) say "COULD-NOT-RUN (missing-runtime -- $SDKHARNESS_BUILD_REASON)"; exit 0 ;;
  *) say "FAIL (build -- blazer or this check did not compile offline: $(tidy_detail "$SDKHARNESS_BUILD_OUT"))"; exit 1 ;;
esac

"$work/check"
exit $?

: <<'__EOF_GO__'
package main

import (
	"context"
	"errors"
	"fmt"
	"io"
	"net/http"
	"os"
	"strconv"
	"strings"
	"time"

	"github.com/Backblaze/blazer/base"
)

type rangeCase struct {
	name, length, span, body, requestRange string
	status                                 int
	offset, size                           int64
	chunked, invalid                       bool
}

type rangeTransport struct {
	fault rangeCase
	calls int
}

func (t *rangeTransport) RoundTrip(req *http.Request) (*http.Response, error) {
	if req.URL.Path == "/b2api/v4/b2_list_buckets" {
		return &http.Response{StatusCode: 200, Header: make(http.Header), Request: req,
			Body: io.NopCloser(strings.NewReader("{\"buckets\":[{\"bucketId\":\"range-bucket\",\"bucketName\":\"range-fixture\",\"bucketType\":\"allPrivate\"}]}"))}, nil
	}
	if req.Method != http.MethodGet || (req.URL.Path != "/file/range-fixture/object" && req.URL.Path != "/b2api/v4/b2_download_file_by_id") {
		return nil, fmt.Errorf("unexpected request: %s %s", req.Method, req.URL.Path)
	}
	t.calls++
	if got := req.Header.Get("Range"); got != t.fault.requestRange {
		return nil, fmt.Errorf("Range = %q, want %q", got, t.fault.requestRange)
	}
	headers := make(http.Header)
	if t.fault.length != "" {
		headers.Set("Content-Length", t.fault.length)
	}
	if t.fault.span != "" {
		headers.Set("Content-Range", t.fault.span)
	}
	length, _ := strconv.ParseInt(t.fault.length, 10, 64)
	resp := &http.Response{StatusCode: t.fault.status, Header: headers, ContentLength: length,
		Body: io.NopCloser(strings.NewReader(t.fault.body)), Request: req}
	if t.fault.chunked {
		resp.ContentLength = -1
		resp.TransferEncoding = []string{"chunked"}
	}
	return resp, nil
}

func runCheck(ctx context.Context) error {
	// Each row describes the wire reply to a range of the object 0123456789.
	// The expected errors and positive bytes are fixed independently of blazer.
	cases := []rangeCase{
		{name: "well-formed 206", status: 206, offset: 2, size: 4, requestRange: "bytes=2-5", length: "4", span: "bytes 2-5/10", body: "2345"},
		{name: "200 at nonzero offset", status: 200, offset: 2, size: 4, requestRange: "bytes=2-5", length: "4", body: "2345", invalid: true},
		{name: "overlong 200", status: 200, size: 4, requestRange: "bytes=0-3", length: "5", body: "01234", invalid: true},
		{name: "overlong 206", status: 206, offset: 2, size: 4, requestRange: "bytes=2-5", length: "5", span: "bytes 2-5/10", body: "23456", invalid: true},
		{name: "chunked 206 without Content-Length", status: 206, offset: 2, size: 4, requestRange: "bytes=2-5", span: "bytes 2-5/10", body: "2345", chunked: true, invalid: true},
		{name: "206 missing Content-Range", status: 206, offset: 2, size: 4, requestRange: "bytes=2-5", length: "4", body: "2345", invalid: true},
		{name: "206 invalid Content-Range", status: 206, offset: 2, size: 4, requestRange: "bytes=2-5", length: "4", span: "not-a-range", body: "2345", invalid: true},
		{name: "206 wrong range start", status: 206, offset: 2, size: 4, requestRange: "bytes=2-5", length: "4", span: "bytes 1-4/10", body: "1234", invalid: true},
	}
	invalid, controls := 0, 0
	for _, byID := range []bool{false, true} {
		method := "by name"
		if byID {
			method = "by ID"
		}
		for _, test := range cases {
			wire := &rangeTransport{fault: test}
			endpoint := strings.TrimRight(os.Getenv("RESILIENCE_SIMULATOR_URL"), "/")
			account := base.NewAuthorizedAccount(base.AuthData{AccountID: "test-account", AuthToken: "test-token", APIURL: endpoint, DownloadURL: endpoint}, base.Transport(wire))
			buckets, err := account.ListBuckets(ctx, "range-fixture")
			if err != nil || len(buckets) != 1 {
				return fmt.Errorf("%s/%s: fixture buckets=%d error=%v", method, test.name, len(buckets), err)
			}
			var reader *base.FileReader
			if byID {
				reader, err = buckets[0].DownloadFileByID(ctx, "range-file", test.offset, test.size, false)
			} else {
				reader, err = buckets[0].DownloadFileByName(ctx, "object", test.offset, test.size, false)
			}
			if wire.calls != 1 {
				if reader != nil {
					reader.Close()
				}
				return fmt.Errorf("%s/%s: download calls=%d, want 1", method, test.name, wire.calls)
			}
			if test.invalid {
				if reader != nil {
					reader.Close()
					return fmt.Errorf("%s/%s: got a reader, want base.ErrInvalidRangeResponse", method, test.name)
				}
				if !errors.Is(err, base.ErrInvalidRangeResponse) {
					return fmt.Errorf("%s/%s: got %v, want base.ErrInvalidRangeResponse", method, test.name, err)
				}
				invalid++
				continue
			}
			if err != nil || reader == nil {
				if reader != nil {
					reader.Close()
				}
				return fmt.Errorf("%s/%s: got reader=%t error=%v, want a successful download", method, test.name, reader != nil, err)
			}
			got, readErr := io.ReadAll(reader)
			closeErr := reader.Close()
			if readErr != nil || closeErr != nil || string(got) != "2345" {
				return fmt.Errorf("%s/%s: body=%q read=%v close=%v, want 2345 and nil errors", method, test.name, got, readErr, closeErr)
			}
			controls++
		}
	}
	if invalid != 14 || controls != 2 {
		return fmt.Errorf("exercised %d malformed replies and %d controls, want 14 and 2", invalid, controls)
	}
	fmt.Println("NOTE blazer download.range_validation: 14 malformed replies rejected with base.ErrInvalidRangeResponse; 2 well-formed 206 controls returned 2345; downloads by name and by ID")
	return nil
}

func main() {
	ctx, cancel := context.WithTimeout(context.Background(), 10*time.Second)
	defer cancel()
	if err := runCheck(ctx); err != nil {
		fmt.Printf("RESILIENCE blazer download.range_validation @simulator: FAIL (range validation -- %v)\n", err)
		os.Exit(1)
	}
	fmt.Println("RESILIENCE blazer download.range_validation @simulator: PASS")
}
__EOF_GO__
